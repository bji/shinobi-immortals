# A bidder who has emptied their account must not be able to make settlement impossible, and neither must anyone
# else.  If the bid account holds an excess that is too small to make the bidder's emptied account rent exempt, then
# returning it would make the transaction fail, so the excess goes to the admin with the bid instead.
#
# This makes its own block 12 3 with a single entry in a 20 second auction, which a new bidder wins and then empties
# their account.  1000 lamports are then transferred to the bid account, and rich_user2 settles the bid once enough
# time has passed since the end of the auction.
if should_run_test anyone_settle_winning_bid_emptied_bidder; then
    TEST_NAME=anyone_settle_winning_bid_emptied_bidder
    make_funded_keypair $LEDGER/emptied_bidder.json 20 finalized
    EMPTIED_BIDDER_PUBKEY=`solxact pubkey $LEDGER/emptied_bidder.json`
    # Create the block, add its entry, set the entry's metadata, and reveal it, which starts its auction
    assert ${TEST_NAME}_setup_a                                                                                      \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_create_block_tx.sh                               \
         $ADMIN_PUBKEY 12 3 0 1 0 $((24*60*60)) \`lamports_from_sol 1000\` 1                                         \
         \`lamports_from_sol 1\` true 20 \`lamports_from_sol 1000\` 0                                                \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert ${TEST_NAME}_setup_b                                                                                      \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_add_entries_to_block_tx.sh                       \
         $ADMIN_PUBKEY 12 3 "http://foo.bar.com" none 0 $SHA2560                                                     \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert ${TEST_NAME}_setup_c                                                                                      \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_set_metadata_bytes_tx.sh                         \
         $ADMIN_PUBKEY 12 3 0 0 $BYTE_0                                                                              \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert ${TEST_NAME}_setup_d                                                                                      \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_reveal_entries_tx.sh                             \
         $ADMIN_PUBKEY 12 3 0 $SALT0                                                                                 \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    # The new bidder bids, and is the only bidder
    assert ${TEST_NAME}_setup_e                                                                                      \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_bid_tx.sh                                         \
         $EMPTIED_BIDDER_PUBKEY 12 3 0 \`lamports_from_sol 1\` \`lamports_from_sol 10\`                              \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/emptied_bidder.json                                                                   \
        | solxact submit l 2>&1`
    # Wait for the auction to end
    echo "Waiting for auction to complete"
    sleep 21
    # The bidder empties their account
    solana transfer -u l -k $LEDGER/emptied_bidder.json $RICH_USER1_PUBKEY ALL --commitment finalized >/dev/null
    if [ "`settle_lamports_of $EMPTIED_BIDDER_PUBKEY`" != "0" ]; then
        echo "FAIL: $TEST_NAME: could not empty the bidder's account"
        exit 1
    fi
    settle_accounts 3 0 $EMPTIED_BIDDER_PUBKEY $RICH_USER2_PUBKEY
    # Wait until rich_user2 is allowed to settle this bid
    settle_wait_until_anyone_may_settle $S_ENTRY
    WINNING_BID=`settle_account_u64 $S_ENTRY $SETTLE_ENTRY_HIGHEST_BID_OFFSET`
    # Someone transfers 1000 lamports to the bid account
    solana transfer -u l -k $LEDGER/rich_user2.json $S_BID 0.000001 --commitment finalized >/dev/null
    TOKEN_ACCOUNT_LAMPORTS=`settle_lamports_of $S_ENTRY_TOKEN`
    ADMIN_BEFORE=`settle_lamports_of $ADMIN_PUBKEY`
    assert $TEST_NAME                                                                                                \
    `settle_script $LEDGER/rich_user2.json $EMPTIED_BIDDER_PUBKEY 12 3 0`
    # The bidder received the token
    if [ "`get_token_balance $S_MINT $EMPTIED_BIDDER_PUBKEY`" != "1" ]; then
        echo "FAIL: $TEST_NAME: the bidder did not receive the token"
        exit 1
    fi
    # The bidder's account is still empty, and the admin received the excess along with the bid
    if [ "`settle_lamports_of $EMPTIED_BIDDER_PUBKEY`" != "0" ]; then
        echo "FAIL: $TEST_NAME: the bidder's emptied account holds `settle_lamports_of $EMPTIED_BIDDER_PUBKEY`"
        exit 1
    fi
    ADMIN_AFTER=`settle_lamports_of $ADMIN_PUBKEY`
    if [ $((ADMIN_AFTER - ADMIN_BEFORE)) -ne $((WINNING_BID + 1000 + TOKEN_ACCOUNT_LAMPORTS)) ]; then
        echo "FAIL: $TEST_NAME: admin received $((ADMIN_AFTER - ADMIN_BEFORE)),"                                     \
             "expected bid $WINNING_BID plus 1000 plus token account rent $TOKEN_ACCOUNT_LAMPORTS"
        exit 1
    fi
    # The purchase price is still the winning bid
    if [ "`settle_account_u64 $S_ENTRY $SETTLE_ENTRY_PURCHASE_PRICE_OFFSET`" != "$WINNING_BID" ]; then
        echo "FAIL: $TEST_NAME: purchase price is not the winning bid of $WINNING_BID"
        exit 1
    fi
fi
