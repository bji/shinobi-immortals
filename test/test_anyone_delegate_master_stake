
# Tests of DelegateMasterStake (21).  In this suite the master stake account is always actively delegated, since
# Shinobi Systems here is the test validator, which never stops voting; so only the refusals can be tested here.  The
# successful delegation of a deactivated master stake account is tested by test/test_master_stake_recovery.sh, which
# runs on its own validator.


# Bad data size
if should_run_test anyone_delegate_master_stake_bad_data; then
    assert_fail anyone_delegate_master_stake_bad_data                                                                \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x3e9'                     \
    `echo "encoding c                                                                                                \
           fee_payer $RICH_USER1_PUBKEY                                                                              \
           program $SELF_PROGRAM_PUBKEY                                                                              \
           account $MASTER_STAKE_PUBKEY w                                                                            \
           account $AUTHORITY_PUBKEY                                                                                 \
           account $CLOCK_SYSVAR_PUBKEY                                                                              \
           account $STAKE_PROGRAM_PUBKEY                                                                             \
           account $STAKE_HISTORY_SYSVAR_PUBKEY                                                                      \
           account $SHINOBI_SYSTEMS_VOTE_PUBKEY                                                                      \
           account $STAKE_CONFIG_PUBKEY                                                                              \
           // Instruction code 21 = DelegateMasterStake //                                                           \
           u8 21                                                                                                     \
           u8 0"                                                                                                     \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
fi


