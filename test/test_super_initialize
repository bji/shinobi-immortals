           account $STAKE_CONFIG_PUBKEY                                                                              \
           account $SYSTEM_PROGRAM_PUBKEY                                                                            \
           account $STAKE_PROGRAM_PUBKEY                                                                             \
           account $SPL_TOKEN_PROGRAM_PUBKEY                                                                         \
           account $METAPLEX_PROGRAM_PUBKEY                                                                          \
           // Instruction code 0 = InitializeData //                                                                 \
           u8 0                                                                                                      \
           // Admin pubkey //                                                                                        \
           pubkey $ADMIN_PUBKEY"                                                                                     \
           // Extra junk //                                                                                          \
           u64 17                                                                                                    \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/super.json                                                                            \
        | solxact submit l 2>&1`
fi

# Issue an invalid super_initialize tx with superuser account that doesn't have sufficient credit.  To to this,
# transfer all except 0.01 SOL from the super to the admin
if should_run_test super_initialize_insufficent_lamports; then
    transfer_all_except $LEDGER/super.json $LEDGER/admin.json 0.01
    assert_fail super_initialize_insufficient_lamports                                                               \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x1'                       \
    `echo "encoding c                                                                                                \
           fee_payer $SUPERUSER_PUBKEY                                                                               \
           program $SELF_PROGRAM_PUBKEY                                                                              \
           account $SUPERUSER_PUBKEY s                                                                               \
           account $STATE_PUBKEY w                                                                                  \
           account $AUTHORITY_PUBKEY w                                                                               \
           account $MASTER_STAKE_PUBKEY w                                                                            \
           account $VOTE_PUBKEY                                                                                      \
           account $KI_MINT_PUBKEY w                                                                                 \
           account $KI_METADATA_PUBKEY w                                                                             \
           account $BID_MARKER_MINT_PUBKEY w                                                                         \
           account $BID_MARKER_METADATA_PUBKEY w                                                                     \
           account $CLOCK_SYSVAR_PUBKEY                                                                              \
           account $RENT_SYSVAR_PUBKEY                                                                               \
           account $STAKE_HISTORY_SYSVAR_PUBKEY                                                                      \
           account $STAKE_CONFIG_PUBKEY                                                                              \
           account $SYSTEM_PROGRAM_PUBKEY                                                                            \
           account $STAKE_PROGRAM_PUBKEY                                                                             \
           account $SPL_TOKEN_PROGRAM_PUBKEY                                                                         \
           account $METAPLEX_PROGRAM_PUBKEY                                                                          \
           // Instruction code 0 = InitializeData //                                                                 \
           u8 0                                                                                                      \
           // Admin pubkey //                                                                                        \
           pubkey $ADMIN_PUBKEY"                                                                                     \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/super.json                                                                            \
        | solxact submit l 2>&1`
    # Leave 10000 SOL in admin
    transfer_all_except $LEDGER/admin.json $LEDGER/super.json 10000
fi    


# Issue a valid super_initialize tx and check to make sure that the correct state account was created
# This test cannot be skipped since the creation of a state account is a prerequisite for all other tests
# Send lamports to the state account, to ensure that if the account already exists, it is properly re-owned
transfer $LEDGER/admin.json $STATE_PUBKEY 0.1
assert super_initialize_success                                                                                      \
`SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY SHINOBI_SYSTEMS_VOTE_PUBKEY=$VOTE_PUBKEY                                   \
     $SOURCE/scripts/super_initialize_tx.sh $SUPERUSER_PUBKEY $ADMIN_PUBKEY                                          \
    | solxact hash l                                                                                                 \
    | solxact sign $LEDGER/super.json                                                                                \
    | solxact submit l 2>&1`

# Ensure that the state account was created and that its contents are as expected -- should be the admin pubkey
EXPECTED_STATE_ACCOUNT_DATA=`(echo 01000000 | xxd -r -p; pubkey_binary $ADMIN_PUBKEY) | base64`
STATE_ACCOUNT_DATA=`get_account_data $STATE_PUBKEY 0 36`
if [ "$EXPECTED_STATE_ACCOUNT_DATA" != "$STATE_ACCOUNT_DATA" ]; then
    echo "FAIL: super_initialize_success: Incorrect account contents:"
    diff <(echo "$EXPECTED_STATE_ACCOUNT_DATA") <(echo "$STATE_ACCOUNT_DATA")
    exit 1
fi


# Issue a valid additional super_initialize tx that should fail because the initialize cannot be repeated once
# it is completed
if should_run_test super_initialize_again; then
    # Preserve the entire account so a rejected initialization cannot silently change any state.
    STATE_ACCOUNT_BEFORE=$(get_account_data $STATE_PUBKEY)
    assert_fail super_initialize_again                                                                               \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x44d'                     \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY SHINOBI_SYSTEMS_VOTE_PUBKEY=$VOTE_PUBKEY                               \
         $SOURCE/scripts/super_initialize_tx.sh $SUPERUSER_PUBKEY $RICH_USER1_PUBKEY                                 \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/super.json                                                                            \
        | solxact submit l 2>&1`

    STATE_ACCOUNT_AFTER=$(get_account_data $STATE_PUBKEY)
    if [ "$STATE_ACCOUNT_BEFORE" != "$STATE_ACCOUNT_AFTER" ]; then
        echo "FAIL: super_initialize_again changed state account contents:"
        diff <(echo "$STATE_ACCOUNT_BEFORE") <(echo "$STATE_ACCOUNT_AFTER")
        exit 1
    fi
fi

# Ensure that the state account still has the expected contents.  The whole account is compared, which also checks
# that it is exactly 36 bytes (data type and admin pubkey).
EXPECTED_STATE_ACCOUNT_DATA=`(echo 01000000 | xxd -r -p; pubkey_binary $ADMIN_PUBKEY) | base64`
STATE_ACCOUNT_DATA=`get_account_data $STATE_PUBKEY`
if [ "$EXPECTED_STATE_ACCOUNT_DATA" != "$STATE_ACCOUNT_DATA" ]; then
    echo "FAIL: super_initialize_success: Incorrect account contents:"
    diff <(echo "$EXPECTED_STATE_ACCOUNT_DATA") <(echo "$STATE_ACCOUNT_DATA")
    exit 1
fi
