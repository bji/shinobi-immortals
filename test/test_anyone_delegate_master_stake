# The master stake account is actively delegated, so there is nothing to do
if should_run_test anyone_delegate_master_stake_already_delegated; then
    assert_fail anyone_delegate_master_stake_already_delegated                                                       \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x412'                     \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY SHINOBI_SYSTEMS_VOTE_PUBKEY=$SHINOBI_SYSTEMS_VOTE_PUBKEY               \
         $SOURCE/scripts/anyone_delegate_master_stake_tx.sh $RICH_USER1_PUBKEY                                       \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
fi
