        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
fi


# Submits a Destake of entry 14 0 0, which is staked by rich_user1 with delegated2_stake, with the Ki destination
# account $1, the Ki mint account $2 (which may include a "w" to make it writable), the Associated Token Account
# program account $3, and the remaining arguments as the instruction data that follows the instruction code (normally
# the no_ki_harvest and no_thaw flags).  Prints the result of submission.
function destake_14_0_0_raw ()
{
    local KI_DESTINATION="$1"
    local KI_MINT="$2"
    local ATA_PROGRAM="$3"
    shift 3

    local BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 14 u32 0 ]`
    local MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 5 pubkey $BLOCK_PUBKEY u16 0 ]`
    local ENTRY_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 15 pubkey $MINT_PUBKEY ]`
    local TOKEN_PUBKEY=`get_splata_account $MINT_PUBKEY $RICH_USER1_PUBKEY`

    echo "encoding c                                                                                                 \
          fee_payer $RICH_USER1_PUBKEY                                                                               \
          program $SELF_PROGRAM_PUBKEY                                                                               \
          account $RICH_USER1_PUBKEY ws                                                                              \
          account $BLOCK_PUBKEY                                                                                      \
          account $ENTRY_PUBKEY w                                                                                    \
          account $RICH_USER1_PUBKEY s                                                                               \
          account $TOKEN_PUBKEY w                                                                                    \
          account $DELEGATED_STAKE_PUBKEY w                                                                          \
          account $KI_DESTINATION                                                                                    \
          account $RICH_USER1_PUBKEY                                                                                 \
          account $MASTER_STAKE_PUBKEY w                                                                             \
          account $KI_MINT                                                                                           \
          account $AUTHORITY_PUBKEY                                                                                  \
          account $CLOCK_SYSVAR_PUBKEY                                                                               \
          account $SYSTEM_PROGRAM_PUBKEY                                                                             \
          account $STAKE_PROGRAM_PUBKEY                                                                              \
          account $STAKE_HISTORY_SYSVAR_PUBKEY                                                                       \
          account $SPL_TOKEN_PROGRAM_PUBKEY                                                                          \
          account $ATA_PROGRAM                                                                                       \
          account $MINT_PUBKEY                                                                                       \
          // Instruction code 15 = Destake //                                                                        \
          u8 15 $@"                                                                                                  \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1
}


# The instruction data must be exactly the instruction code followed by the no_ki_harvest and no_thaw flags
if should_run_test user_destake_bad_data_size; then
    KI_DESTINATION_PUBKEY=`get_splata_account $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`
    # No flags at all (Error_InvalidDataSize, 1001)
    assert_fail user_destake_bad_data_size_none                                                                      \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x3e9'                     \
    `destake_14_0_0_raw "$KI_DESTINATION_PUBKEY w" "$KI_MINT_PUBKEY w" $SPLATA_PROGRAM_PUBKEY`
    # Only the no_ki_harvest flag
    assert_fail user_destake_bad_data_size_short                                                                     \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x3e9'                     \
    `destake_14_0_0_raw "$KI_DESTINATION_PUBKEY w" "$KI_MINT_PUBKEY w" $SPLATA_PROGRAM_PUBKEY u8 0`
    # A byte after the flags
    assert_fail user_destake_bad_data_size_long                                                                      \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x3e9'                     \
    `destake_14_0_0_raw "$KI_DESTINATION_PUBKEY w" "$KI_MINT_PUBKEY w" $SPLATA_PROGRAM_PUBKEY u8 0 u8 0 u8 0`
fi


