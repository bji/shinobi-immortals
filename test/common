# Run a solana CLI stake command, retrying while the stake program rejects it with EpochRewardsActive (stake program
# error 16, 0x10).  At the start of each epoch the runtime distributes stake rewards over several slots, and stake
# accounts cannot be modified until it finishes; with the test validator's short epochs, setup commands land in
# that window often enough to make the suite fail intermittently.  Any other error is reported and returned at once.
function solana_stake ()
{
    local attempt output

    for attempt in `seq 1 60`; do
        set +e
        if output=`solana "$@" 2>&1`; then
            set -e
            echo "$output"
            return 0
        fi
        set -e
        # The error is reported as "custom program error: 0x10;" when the transaction fails simulation, and as
        # "custom program error: 0x10" at the end of the output when it passes simulation but fails on chain; in
        # both cases the failed transaction changed nothing, so it is safe to retry.  The hex digit check
        # ensures that other errors such as 0x100 do not match.
        # The solana command line tool can also refuse the stake action itself, before sending any transaction, with
        # "stake action is not permitted while the epoch rewards period is active"; that is equally safe to retry.
        if printf '%s\n' "$output" | grep -Eq 'custom program error: 0x10($|[^0-9a-fA-F])' ||
           printf '%s\n' "$output" | grep -q 'epoch rewards period is active'; then
            # Rewards are still being distributed; wait and try again
            sleep 1
        else
            echo "$output" >&2
            return 1
        fi
    done

    echo "$output" >&2
    return 1
}


# The log line that the stake program emits when it rejects an instruction with EpochRewardsActive (stake program
# error 16, 0x10).  Matching the stake program's own failure line, rather than just the error number, ensures that the
# same number returned by any other program is never mistaken for it.  This program's own errors are all 1000 or
# higher, so a cross-program invocation of the stake program that fails this way produces exactly this line too.
STAKE_EPOCH_REWARDS_ACTIVE_LOG='Program Stake11111111111111111111111111111111111111 failed: custom program error: 0x10'


# The tests build transactions with pipelines such as "... | solxact hash l | solxact sign KEY | solxact submit l".
# Any transaction that makes this program invoke the stake program can be rejected with EpochRewardsActive for the
# same reason that solana_stake retries (see above).  Retrying such a transaction requires a fresh recent blockhash, and
# a new blockhash invalidates every signature, so it must also be re-signed by every one of its signers.  But by the
# time a transaction reaches "solxact submit", the keys that signed it are no longer known.
#
# So solxact is wrapped by this function.  "solxact sign" records, for each transaction that it outputs, the
# transaction as it was before any signing and the full list of key files that signed it.  "solxact submit" uses that
# record to rebuild, re-sign and resubmit a transaction that the stake program rejected with EpochRewardsActive.  All
# other solxact subcommands pass straight through to the real solxact.
function solxact ()
{
    case "$1" in
        sign)
            shift
            solxact_sign "$@"
            ;;
        submit)
            shift
            solxact_submit "$@"
            ;;
        *)
            command solxact "$@"
            ;;
    esac
}


# The directory holding solxact_sign's records.  Each record is named by the sha256 of the signed transaction that it
# describes: <sha256>.unsigned holds the transaction before any signing, and <sha256>.keys holds the key files that
# signed it, one per line.  Key file paths are all under $LEDGER, which never contains whitespace.
function solxact_signing_dir ()
{
    echo $LEDGER/solxact_signing
}


# Signs a transaction exactly as "solxact sign" does, recording how it was signed (see solxact above).
function solxact_sign ()
{
    # Without a ledger directory there is nowhere to keep records, so just sign
    if [ -z "$LEDGER" ]; then
        command solxact sign "$@"
        return
    fi

    local dir=`solxact_signing_dir`
    mkdir -p $dir

    local work=`mktemp -d`
    local status=0

    # Save the transaction to be signed, so that it can be both signed and recorded
    cat > $work/in

    # If this transaction was itself output by a recorded signing (as when signing is split across several "solxact
    # sign" commands), carry that record forward, so that the record of this signing names every signer of the
    # transaction and the transaction from before any of them signed.  Otherwise this is the first signing.
    local in_hash=`sha256_of < $work/in`
    if [ -f $dir/$in_hash.unsigned ]; then
        cp $dir/$in_hash.unsigned $work/unsigned
        cp $dir/$in_hash.keys $work/keys
    else
        cp $work/in $work/unsigned
        : > $work/keys
    fi

    # Add this signing's keys to the list of signers
    local key
    for key in "$@"; do
        echo "$key" >> $work/keys
    done

    # Sign; if signing fails, report it exactly as solxact did and record nothing
    command solxact sign "$@" < $work/in > $work/out || status=$?
    if [ $status -eq 0 ]; then
        # Record how the signed transaction was made, under the sha256 of the signed transaction
        local out_hash=`sha256_of < $work/out`
        cp $work/unsigned $dir/$out_hash.unsigned
        cp $work/keys $dir/$out_hash.keys
    fi

    cat $work/out
    rm -rf $work
    return $status
}


# Succeeds if the stake program rejected the transaction whose "solxact submit" output is in [out] and [err] with
# EpochRewardsActive.  That is reported in one of two ways: in the simulation logs that solxact prints when the
# transaction fails simulation, or, when the transaction passed simulation and was sent, in the logs of its on-chain
# execution, which must then be fetched.
function solxact_rejected_for_epoch_rewards ()
{
    local out=$1
    local err=$2

    # Rejected in simulation
    if cat $out $err | grep -Fq "$STAKE_EPOCH_REWARDS_ACTIVE_LOG"; then
        return 0
    fi

    # Sent; fetch the execution result and look for the failure in its logs.  If the result can't be fetched, it is
    # not known to have been rejected, and assert or assert_fail will report the missing result.
    local output=`cat $out`
    if [[ "$output" = Transaction\ signature:\ * ]]; then
        local signature=`echo "$output" | cut -d ' ' -f 3`
        local json
        if json=`wait_for_transaction "$signature"`; then
            echo "$json" | jq -e --arg log "$STAKE_EPOCH_REWARDS_ACTIVE_LOG"                                         \
                              '.result.meta.err != null and
                               any(.result.meta.logMessages[]?; . == $log)' >/dev/null
            return
        fi
    fi

    return 1
}


# Submits a transaction exactly as "solxact submit" does, but while the stake program rejects it with
# EpochRewardsActive, rebuilds it with a fresh recent blockhash, re-signs it with all of its signers, and resubmits it.
# Every attempt that was rejected changed nothing, so this is safe.  Any other result, success or failure, is reported
# exactly as solxact reported it.
function solxact_submit ()
{
    local work=`mktemp -d`
    local attempt status
    local dir=`solxact_signing_dir`

    # Save the transaction, since it may need to be submitted more than once
    cat > $work/tx

    # Give up after about a minute, as solana_stake does
    for attempt in `seq 1 60`; do
        status=0
        command solxact submit "$@" < $work/tx > $work/out 2> $work/err || status=$?

        # Anything other than an EpochRewardsActive rejection is the result
        if ! solxact_rejected_for_epoch_rewards $work/out $work/err; then
            break
        fi

        # Rewards are still being distributed; wait before trying again
        sleep 1

        # Rebuild the transaction from its signing record: apply a fresh blockhash to the transaction from before it
        # was signed, then sign it again with all of the keys that signed it.  Record the rebuilt transaction too, so
        # that it can be rebuilt again if it is also rejected.
        local tx_hash=`sha256_of < $work/tx`
        if [ -n "$LEDGER" ] && [ -f $dir/$tx_hash.unsigned ]; then
            command solxact hash "$@" < $dir/$tx_hash.unsigned                                                        \
                | command solxact sign `cat $dir/$tx_hash.keys` > $work/rebuilt || break
            # The rebuilt transaction is identical if the blockhash has not changed, and then is already recorded
            local rebuilt_hash=`sha256_of < $work/rebuilt`
            if [ "$rebuilt_hash" != "$tx_hash" ]; then
                cp $dir/$tx_hash.unsigned $dir/$rebuilt_hash.unsigned
                cp $dir/$tx_hash.keys $dir/$rebuilt_hash.keys
            fi
            mv $work/rebuilt $work/tx
        # Without a record, the transaction can't be re-signed.  If it was only rejected in simulation, it was never
        # executed, so the same transaction can be submitted again while its blockhash is still valid.  If it was
        # executed, it can't be submitted again, so report its result.
        elif cat $work/out | grep -q '^Transaction signature: '; then
            break
        fi
    done

    # Report the final attempt's result exactly as solxact did
    cat $work/out
    cat $work/err >&2
    rm -rf $work
    return $status
}


function make_stake_account ()
{
    local AUTHORITY_KEY_FILE=$1
    local STAKE_KEY_FILE=$2
    local SOL=$3

    echo "Creating stake account @ $STAKE_KEY_FILE authority $AUTHORITY_KEY_FILE with lamports $SOL"

    solana-keygen new -o $STAKE_KEY_FILE --no-bip39-passphrase --force --silent

    solana_stake -u l create-stake-account -k $AUTHORITY_KEY_FILE $STAKE_KEY_FILE $SOL $4 >/dev/null
}


function get_splata_account ()
{
    local mint=$1
    local user=$2

    pda "ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL" [ pubkey $user pubkey $SPL_TOKEN_PROGRAM_PUBKEY               \
                                                         pubkey $mint ]
}


function compute_metadata_sha256 ()
{
    local metadata_base64=$1
    local salt=$2

    # Convert salt to 8 digit hex, little endian
    salt=`printf "%016x" $salt | tac -rs ..`

    (echo "$metadata_base64" | base64 -d | sha256sum | cut -d ' ' -f 1 | xxd -r -p;                                  \
     echo $salt | xxd -r -p | tr -d '\n') | sha256sum | cut -d ' ' -f 1
}


function get_account_data ()
{
    local ACCOUNT_PUBKEY=$1
    local DATA_OFFSET=$2
    local DATA_LEN=$3

    if [ -n "$DATA_OFFSET" ]; then
        DATA_SLICE="\"dataSlice\":{\"offset\":$DATA_OFFSET,\"length\":$DATA_LEN},"
    else
        DATA_SLICE=
    fi

    DATA=`curl -s http://localhost:8899 -X POST -H "Content-Type: application/json" -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getAccountInfo\",\"params\":[\"$ACCOUNT_PUBKEY\",{$DATA_SLICE\"encoding\":\"base64\"}]}" | jq -r ".result.value.data[0]"`

    if [ "$DATA" = "null" ]; then
        echo -n ""
    else
        echo -n "$DATA"
    fi
}


# Prints the state of the associated token account of mint $1 for user $2: 1 if it is Initialized (usable), 2 if it
# is Frozen, 0 if it is uninitialized or does not exist.  The state is the single byte at offset 108 of an SPL Token
# token account (after the 32 byte mint, 32 byte owner, 8 byte amount, and 36 byte optional delegate).
function get_token_account_state ()
{
    local mint=$1
    local user=$2

    local account=`get_splata_account $mint $user`

    local DATA=`get_account_data $account 108 1`

    if [ -z "$DATA" ]; then
        echo 0
    else
        echo "$DATA" | base64 -d | od -An -N1 -tu1 -v | tr -d [:space:]
    fi
}


# Succeeds if the freeze authority of mint $1 is the pubkey $2, and fails otherwise (including if the mint has no
# freeze authority).  In an SPL Token mint account, the freeze authority is a 4 byte tag at offset 46 (after the 36
# byte optional mint authority, 8 byte supply, 1 byte decimals, and 1 byte is_initialized), which is 1 if there is a
# freeze authority, followed by the 32 byte pubkey.  The two are compared as hex strings.
function mint_freeze_authority_is ()
{
    local mint=$1
    local expected=$2

    local ACTUAL=`get_account_data $mint 46 36 | base64 -d | od -An -tx1 -v | tr -d [:space:]`
    local EXPECTED=01000000`pubkey_binary $expected | od -An -tx1 -v | tr -d [:space:]`

    [ -n "$ACTUAL" -a "$ACTUAL" = "$EXPECTED" ]
}


function get_token_balance ()
{
    local mint=$1
    local user=$2

    local account=`get_splata_account $mint $user`

    local DATA=`get_account_data $account`

    if [ -z "$DATA" ]; then
        echo 0
    else
        # The amount is at offset 64
        echo "$DATA" | base64 -d | od -An -j64 -N8 -tu8 -v | tr -d [:space:]
    fi
}


function hex_digit ()
{
    local decimal=$1

    if [ $decimal -lt 16 ]; then
        echo -n "0"
    fi
    
    echo "16o $x p" | dc
}


function pubkey_binary ()
{
    local pubkey=$1

    for x in `solxact pubkey bytes $1 | tr -d '[' | tr -d ']' | tr ',' ' '`; do hex_digit $x; done | xxd -r -p
}


# The solana command is messed up and sometimes epoch-info fails
function current_epoch ()
{
    solana -u l epoch-info | grep ^Epoch: | cut -d ' ' -f 2
}


function current_block_time ()
{
    solana -u l block-time --output=json | jq .timestamp
}


function sleep_until_next_epoch ()
{
    START_EPOCH=`current_epoch`
    while true; do
        echo "Waiting for epoch $START_EPOCH to complete"
        sleep 1
        CURRENT_EPOCH=`current_epoch`
        if [ $CURRENT_EPOCH != $START_EPOCH ]; then
            echo "Waiting for epoch $START_EPOCH to complete"
            sleep 1
            break
        fi
    done
}


# Write a single byte value at a byte offset within a file, without changing the file's length
function poke_byte ()
{
    local FILE=$1
    local OFFSET=$2
    local VALUE=$3

    printf "\\$(printf '%03o' $VALUE)" | dd of=$FILE bs=1 seek=$OFFSET conv=notrunc status=none
}


# Create a genesis fixture for an Entry that is already at level index 8 (displayed level 9).  Level progression is
# time-gated by design (months of epochs), so no sequence of transactions on a local validator can reach the maximum
# level; the only way to test the maximum-level rejection is to start the validator with such an Entry already in
# place.  Only the fields that LevelUp examines before rejecting a maximum-level entry are set; all others are zero.
# Sets MAX_LEVEL_ENTRY_PUBKEY and writes $FIXTURES/max_level_entry.json.
# Byte offsets (which must match program/inc/entry.h, and which are also used by scripts/show.sh):
#   0   data_type (u32): 3 = DataType_Entry
#   168 reveal_sha256: all zero, meaning revealed
#   208 purchase_price_lamports (u64): non-zero, meaning owned
#   304 level (u8): 8
#   308 metadata.level_1_credits (u32): 100
function make_max_level_entry_fixture ()
{
    local PROGRAM_PUBKEY=$1
    local DATA_FILE=$FIXTURES/max_level_entry.bin
    # sizeof(Entry)
    local SIZE=3176
    # Rent exempt minimum: (data size + 128 bytes account overhead) * 3480 lamports/byte-year * 2 years
    local LAMPORTS=$(((SIZE + 128) * 3480 * 2))

    # The fixture's address is arbitrary; LevelUp does not derive or check the entry account's address
    solana-keygen new -o $FIXTURES/max_level_entry_address.json --no-bip39-passphrase --silent
    export MAX_LEVEL_ENTRY_PUBKEY=`solxact pubkey $FIXTURES/max_level_entry_address.json`

    # Start with all zeroes, then set the individual fields
    dd if=/dev/zero of=$DATA_FILE bs=$SIZE count=1 status=none
    poke_byte $DATA_FILE 0 3
    poke_byte $DATA_FILE 208 1
    poke_byte $DATA_FILE 304 8
    poke_byte $DATA_FILE 308 100

    # Write the account in the JSON format that solana-test-validator --account loads
    cat > $FIXTURES/max_level_entry.json <<EOF
{"pubkey":"$MAX_LEVEL_ENTRY_PUBKEY","account":{"lamports":$LAMPORTS,"data":["`base64 < $DATA_FILE | tr -d '\n'`","base64"],"owner":"$PROGRAM_PUBKEY","executable":false,"rentEpoch":0,"space":$SIZE}}
EOF
}


# The validator's current Clock.unix_timestamp, which is what the program uses to determine level credit windows.
# The Clock sysvar's unix_timestamp is the signed 64 bit value at byte offset 32.
function clock_unix_timestamp ()
{
    get_account_data $CLOCK_SYSVAR_PUBKEY 32 8 | base64 -d | od -An -td8 | tr -d ' '
}


# Wait until the validator's clock is in a later level credit window than it is now
function sleep_until_next_level_credit_window ()
{
    local START_WINDOW=$((`clock_unix_timestamp` / LEVEL_CREDIT_WINDOW_SECONDS))

    echo "Waiting for level credit window $START_WINDOW to complete"
    while [ $((`clock_unix_timestamp` / LEVEL_CREDIT_WINDOW_SECONDS)) -eq $START_WINDOW ]; do
        sleep 1
    done
}


# Prints the Ki token base units (ten per whole Ki) that a harvest should mint for earned lamports $1, current
# delegated stake lamports $2, and ki_factor $3.  This independently mirrors harvest_ki() using dc's arbitrary
# precision integers (see ki_reference in test/calculation_vectors.sh): the earnings are scaled by the effective
# stake ratio K*(K+x)/(K*K+K*x+x*x), with K = 50 SOL and the stake x, both measured in units of 100 lamports, made ten
# times larger for as long as x exceeds 2,000,000,000 units, as the program measures them; the effective lamports are
# converted to whole Ki by multiplying whole SOL and remaining lamports by the factor separately; and the result is
# multiplied by ten for the token's one decimal place.
function expected_ki_mint ()
{
    local EARNED=$1
    local STAKE=$2
    local FACTOR=$3

    # x and K in units of 100 lamports, then in larger units while x is too large
    local X=$((STAKE / 100))
    local K=500000000
    while [ $X -gt 2000000000 ]; do
        X=$((X / 10))
        K=$((K / 10))
    done
    # Effective earned lamports
    local EFFECTIVE=`printf '%s\n' "$EARNED $K $K $X + * * $K $K * $K $X * + $X $X * + / p" | dc`
    # Whole Ki: whole SOL times factor, plus remaining lamports times factor divided by lamports per SOL; then ten
    # token base units per Ki
    printf '%s\n' "$EFFECTIVE 1000000000 / $FACTOR * $EFFECTIVE 1000000000 % $FACTOR * 1000000000 / + 10 * p" | dc
}


function setup ()
{
    # The level credit window length that the test program is built with (production uses 5 days).  It must give at
    # least 3 windows per 365 day year (see util_calculations.c).  60 seconds is long enough for consecutive level-up transactions to usually land in the
    # same window, and short enough to wait for the next window.
    export LEVEL_CREDIT_WINDOW_SECONDS=60

    # The number of seconds after the end of an auction during which only the winning bidder may settle the winning
    # bid, that the test program is built with (production uses 30 days).  It is long enough for the tests to try a
    # settlement by someone else that is too soon, and short enough to wait out.
    export SETTLE_WINNING_BID_DELAY_SECONDS=30

    # The number of seconds by which a bid near the end of an auction extends it, that the test program is built with
    # (production uses 10 minutes).  The shared tests run auctions only 20 seconds long and wait a fixed time for them
    # to end, so by default extensions are turned off (0: no bid is ever within 0 seconds of the end).
    # test/test_auction_extension.sh, which tests extensions, sets a value before calling setup.
    export AUCTION_EXTENSION_SECONDS=${AUCTION_EXTENSION_SECONDS:-0}

    # Make a temporary directory to hold the validator ledger
    export LEDGER=`mktemp -d`

    # Touch a file there so that it can be located
    touch $LEDGER/this_is_a_test_ledger
    
    echo "Starting test validator @ $LEDGER"

    # On exit be sure to kill the test validator and clean up after it
    trap "teardown $LEDGER" EXIT

    # Genesis fixtures live outside of the ledger directory so that the validator's --reset cannot disturb them
    export FIXTURES=$LEDGER-fixtures
    mkdir $FIXTURES

    # The program keypair must exist before the validator starts, because the fixture accounts below are owned by
    # the program.  It is moved into the ledger directory, where the rest of the tests expect it, once the
    # validator is running.
    solana-keygen new -o $FIXTURES/program.json --no-bip39-passphrase --silent
    make_max_level_entry_fixture `solxact pubkey $FIXTURES/program.json`

    # Start the test validator
    solana-test-validator --alpenglow --ledger $LEDGER --ticks-per-slot 16 --slots-per-epoch 100 --reset             \
                          -u https://api.mainnet-beta.solana.com -c metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s      \
                          -c PwDiXFxQsGra4sFFTT8r1QWRMd4vfumiWC1jfWNfdYT                                             \
                          --account $MAX_LEVEL_ENTRY_PUBKEY $FIXTURES/max_level_entry.json >/dev/null &
    
    echo "Waiting 10 seconds for it to settle"
    
    # Give it time to start
    sleep 10

    # Ten seconds is usually enough, but not always.  Wait for up to a further minute for the validator to answer
    # requests, and stop here with a clear message if it never does, rather than failing obscurely later on.
    local STARTUP_WAITED=0
    while ! solana -u l cluster-version >/dev/null 2>&1; do
        if [ $STARTUP_WAITED -ge 60 ]; then
            echo "FAIL: the test validator did not start"
            exit 1
        fi
        sleep 1
        STARTUP_WAITED=$((STARTUP_WAITED + 1))
    done
    
    # Detect the vote account
    export VALIDATOR_PUBKEY=`solana -u http://localhost:8899 validators | head -2 | tail -1 | awk '{ print $2 }'`
    export VOTE_PUBKEY=`solana -u http://localhost:8899 validators | head -2 | tail -1 | awk '{ print $3 }'`
    
    # Create keys: program, super, admin, rich_user1, rich_user2, poor_user, nonexistent_user
    # The program keypair was created before the validator started (see above); it needs no funds
    mv $FIXTURES/program.json $LEDGER/program.json
    make_funded_keypair $LEDGER/super.json 100000
    make_funded_keypair $LEDGER/admin.json 100000
    make_funded_keypair $LEDGER/rich_user1.json 100000
    make_funded_keypair $LEDGER/rich_user2.json 100000
    make_funded_keypair $LEDGER/poor_user.json 0.01
    make_funded_keypair $LEDGER/nonexistent_user.json 0 finalized

    # Choose the vote account that the program is built to treat as Shinobi Systems.  Normally this is the test
    # validator's own vote account.  But the test validator is the only validator that votes, and so the only one
    # whose delegators earn rewards; a test that needs stake to earn rewards at a validator other than Shinobi Systems
    # sets SEPARATE_SHINOBI_SYSTEMS_VOTE=1, which creates a new vote account (which never votes) to stand in for
    # Shinobi Systems, leaving the test validator's vote account to play the part of some other validator.
    if [ -n "$SEPARATE_SHINOBI_SYSTEMS_VOTE" ]; then
        echo "Creating separate Shinobi Systems vote account"
        solana-keygen new -o $LEDGER/shinobi_validator.json --no-bip39-passphrase --force --silent
        solana-keygen new -o $LEDGER/shinobi_vote.json --no-bip39-passphrase --force --silent
        # The vote program requires the validator identity account to be funded when creating the vote account
        transfer $LEDGER/rich_user1.json `solxact pubkey $LEDGER/shinobi_validator.json` 10
        solana -u l create-vote-account -k $LEDGER/rich_user1.json $LEDGER/shinobi_vote.json                         \
               $LEDGER/shinobi_validator.json `solxact pubkey $LEDGER/rich_user1.json` --commitment finalized >/dev/null
        export SHINOBI_SYSTEMS_VOTE_PUBKEY=`solxact pubkey $LEDGER/shinobi_vote.json`
    else
        export SHINOBI_SYSTEMS_VOTE_PUBKEY=$VOTE_PUBKEY
    fi

    # Build the program
    echo "Making build script"
    $SOURCE/make_build_program.sh $LEDGER/program.json $LEDGER/super.json $SHINOBI_SYSTEMS_VOTE_PUBKEY               \
        > $LEDGER/build_program.sh.in
    # The test program differs from a production build in exactly three respects: a short level credit window, so
    # that window rollover can be tested in real time; a short delay before anyone other than the winning bidder may
    # settle a winning bid, so that the tests can wait it out; and the auction extension (see
    # AUCTION_EXTENSION_SECONDS above).  Production builds have no way to set these
    # (the generated build script has no override hook), so the defines are inserted here, into the test's copy of
    # the build script only, immediately after the program include directory argument.
    awk -v WINDOW=$LEVEL_CREDIT_WINDOW_SECONDS -v DELAY=$SETTLE_WINNING_BID_DELAY_SECONDS                            \
        -v EXTENSION=$AUCTION_EXTENSION_SECONDS                                                                     \
        '{ print } /^ *-I\$SOURCE_ROOT\/program / { print "    -DLEVEL_CREDIT_WINDOW_SECONDS=" WINDOW "ul \\";       \
                                                    print "    -DSETTLE_WINNING_BID_DELAY_SECONDS=" DELAY "ul \\";   \
                                                    print "    -DAUCTION_EXTENSION_SECONDS=" EXTENSION "ul \\" }' \
        $LEDGER/build_program.sh.in > $LEDGER/build_program.sh
    # Fail loudly if the build script's format changed and the define could not be inserted
    if ! grep -q -- "-DLEVEL_CREDIT_WINDOW_SECONDS=${LEVEL_CREDIT_WINDOW_SECONDS}ul" $LEDGER/build_program.sh; then
        echo "FAIL: could not insert LEVEL_CREDIT_WINDOW_SECONDS into the test build script"
        exit 1
    fi
    if ! grep -q -- "-DSETTLE_WINNING_BID_DELAY_SECONDS=${SETTLE_WINNING_BID_DELAY_SECONDS}ul" $LEDGER/build_program.sh
    then
        echo "FAIL: could not insert SETTLE_WINNING_BID_DELAY_SECONDS into the test build script"
        exit 1
    fi
    if ! grep -q -- "-DAUCTION_EXTENSION_SECONDS=${AUCTION_EXTENSION_SECONDS}ul" $LEDGER/build_program.sh; then
        echo "FAIL: could not insert AUCTION_EXTENSION_SECONDS into the test build script"
        exit 1
    fi
    chmod +x $LEDGER/build_program.sh
    echo "Building program"
    (cd $LEDGER;                                                                                                     \
     SDK_ROOT=$SOURCE/sdk SOURCE_ROOT=$SOURCE ./build_program.sh)
    
    # Deploy the program.
    echo "Deploying program"
    # Not sure why, but need to sleep to ensure the following succeeds
    sleep 5
    solana -k $LEDGER/super.json -u l program deploy --program-id $LEDGER/program.json $LEDGER/program.so            \
           --commitment finalized >/dev/null 2>/dev/null
    
# Compute pubkeys

    export         SELF_PROGRAM_PUBKEY=`solxact pubkey $LEDGER/program.json`
    export            SUPERUSER_PUBKEY=`solxact pubkey $LEDGER/super.json`
    export                ADMIN_PUBKEY=`solxact pubkey $LEDGER/admin.json`
    export           RICH_USER1_PUBKEY=`solxact pubkey $LEDGER/rich_user1.json`
    export           RICH_USER2_PUBKEY=`solxact pubkey $LEDGER/rich_user2.json`
    export            POOR_USER_PUBKEY=`solxact pubkey $LEDGER/poor_user.json`
    export     NONEXISTENT_USER_PUBKEY=`solxact pubkey $LEDGER/nonexistent_user.json`
    export       SYSTEM_PROGRAM_PUBKEY="11111111111111111111111111111111"
    export    SPL_TOKEN_PROGRAM_PUBKEY="TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
    export       SPLATA_PROGRAM_PUBKEY="ATokenGPvbdGVxr1b2hvZbsiqW5xWH25efTNsLJA8knL"
    export        STAKE_PROGRAM_PUBKEY="Stake11111111111111111111111111111111111111"
    export         CLOCK_SYSVAR_PUBKEY="SysvarC1ock11111111111111111111111111111111"
    export          RENT_SYSVAR_PUBKEY="SysvarRent111111111111111111111111111111111"
    export     METAPLEX_PROGRAM_PUBKEY="metaqbxxUerdq28cj1RbAWkYQm3ybzjb6a8bt518x1s"
    export STAKE_HISTORY_SYSVAR_PUBKEY="SysvarStakeHistory1111111111111111111111111"
    export         STAKE_CONFIG_PUBKEY="StakeConfig11111111111111111111111111111111"
    export               STATE_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 1 ]`
    export            AUTHORITY_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 2 ]`
    export              KI_MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 3 ]`
    export      BID_MARKER_MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 7 ]`
    export          KI_METADATA_PUBKEY=`pda $METAPLEX_PROGRAM_PUBKEY                                                 \
                                            [ string metadata                                                        \
                                              pubkey $METAPLEX_PROGRAM_PUBKEY                                        \
                                              pubkey $KI_MINT_PUBKEY ]`
    export  BID_MARKER_METADATA_PUBKEY=`pda $METAPLEX_PROGRAM_PUBKEY                                                 \
                                            [ string metadata                                                        \
                                              pubkey $METAPLEX_PROGRAM_PUBKEY                                        \
                                              pubkey $BID_MARKER_MINT_PUBKEY ]`
}


function teardown ()
{
    local LEDGER=$1
    
    echo "Stopping test validator @ $LEDGER"

    killall -9 solana-test-validator

    # Wait for the validator process to be gone, so that its ports are free again.  "make test" runs several test
    # scripts one after another, each of which starts its own validator; a validator that is started while the
    # previous one is still exiting cannot bind its ports and fails to start.  killall -0 sends no signal, it only
    # reports whether such a process still exists.  Give up waiting after 30 seconds.
    local WAITED=0
    while killall -0 solana-test-validator 2>/dev/null && [ $WAITED -lt 30 ]; do
        sleep 1
        WAITED=$((WAITED + 1))
    done

    rm -rf $LEDGER $LEDGER-fixtures
}
