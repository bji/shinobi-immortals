# Independently compute P(k) in tenths of a level credit using dc. The metadata
# contains whole first-upgrade credits, the fixed level-zero Ki factor, and the
# expected annual reward rate in basis points. The contribution is in whole Ki.
# P(k) = 6*L*k / (N*(5*B+k)) with B = factor*50*(bps/10000)/N Ki per window,
# which simplifies to 240*L*k / (factor*bps + 40*N*k).  N is the number of level
# credit windows per year, which for the test build is 31536000 divided by the
# test's LEVEL_CREDIT_WINDOW_SECONDS.
function level_credit_reference ()
{
    local first=$1 factor=$2 bps=$3 contribution=$4 windows=$((31536000 / LEVEL_CREDIT_WINDOW_SECONDS)) cost total=0
    cost=$(printf '%s\n' "$first 10 * p" | dc)
    for ((index=0; index<8; ++index)); do
        total=$(printf '%s\n' "$total $cost + p" | dc)
        cost=$(printf '%s\n' "$cost d 2 / + p" | dc)
    done
    printf '%s\n' "$total 240 * $contribution * $factor $bps * 40 $windows * $contribution * + / p" | dc
}

# Independently compute the least window Ki total k for which P(k) (see level_credit_reference) is at least $4 tenths
# of a credit, or "none" if no k reaches it.  This is how much Ki LevelUp actually burns: never more than the least
# that earns the credits awarded.  With A = 240*L, C = factor*bps and D = 40*N, P(k) = floor(A*k / (C + D*k)), and
# P(k) >= T exactly when k*(A - T*D) >= T*C.  So no k reaches T if A <= T*D, and otherwise the least k is
# ceil(T*C / (A - T*D)).
function level_credit_least_ki_reference ()
{
    local first=$1 factor=$2 bps=$3 target=$4 windows=$((31536000 / LEVEL_CREDIT_WINDOW_SECONDS)) cost total=0 e
    cost=$(printf '%s\n' "$first 10 * p" | dc)
    for ((index=0; index<8; ++index)); do
        total=$(printf '%s\n' "$total $cost + p" | dc)
        cost=$(printf '%s\n' "$cost d 2 / + p" | dc)
    done
    # E = A - T*D; dc prints a negative number with a leading underscore
    e=$(printf '%s\n' "$total 240 * $target 40 * $windows * - p" | dc)
    if [ "$e" = "0" ] || [ "${e:0:1}" = "_" ] || [ "${e:0:1}" = "-" ]; then
        echo none
        return
    fi
    # ceil(T*C / E) = (T*C + E - 1) / E
    printf '%s\n' "$target $factor * $bps * $e + 1 - $e / p" | dc
}

# Prints entry 16 0 0's owned.last_ki_harvest_stake_account_lamports, the delegated stake at which Ki was last
# harvested, which is at byte offset 296 of the Entry
function entry_ki_baseline ()
{
    local block=`pda $SELF_PROGRAM_PUBKEY [ u8 10 u32 16 u32 0 ]`
    local mint=`pda $SELF_PROGRAM_PUBKEY [ u8 4 pubkey $block u16 0 ]`
    local entry=`pda $SELF_PROGRAM_PUBKEY [ u8 11 pubkey $mint ]`
    get_account_data $entry 296 8 | base64 -d | od -An -tu8 -v | tr -d '[:space:]'
}

# Check the full contribution: raw Ki burned, window accounting, lifetime credits,
# and every cumulative threshold crossed. A contribution need not change level.
# $2 is the amount of Ki requested.  LevelUp burns only the least Ki that earns the credits awarded, which may be less
# than that (see level_credit_least_ki_reference); the checks use the amount actually expected to be burned.
# Sets LEVEL_UP_OLD_WINDOW, LEVEL_UP_NEW_WINDOW, LEVEL_UP_OLD_KI and LEVEL_UP_NEXT_TOTAL (the window Ki total before
# and after the contribution, as checked against the entry) for use by callers.
function apply_level_ki_and_check ()
{
    local test_name=$1 amount=$2 before after balance new_balance first factor bps old_window new_window old_ki
    local old_credits expected added previous_total next_total expected_level=0 cost threshold=0 deciki_amount
    local ki_baseline_before ki_baseline_after harvest_factor harvested=0 requested_total least burned
    before=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 0)
    balance=$(get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY)
    ki_baseline_before=`entry_ki_baseline`
    assert "$test_name"                                                                                              \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_level_up_tx.sh                                    \
         $RICH_USER1_PUBKEY 16 0 0 $amount $DELEGATED_STAKE_PUBKEY                                                   \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    after=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 0)
    first=$(echo "$before" | jq -r '.metadata.level_1_credits')
    factor=$(echo "$before" | jq -r '.metadata.level_metadata[0].ki_factor')
    bps=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l block 16 0 |                              \
              jq -r '.configuration.expected_annual_reward_bps')
    old_window=$(echo "$before" | jq -r '.most_recent_ki_applied_window')
    new_window=$(echo "$after" | jq -r '.most_recent_ki_applied_window')
    # The window that the program recorded must be the one containing the time at which it ran, which is no
    # later than now
    if [ "$new_window" -gt "$((`clock_unix_timestamp` / LEVEL_CREDIT_WINDOW_SECONDS))" ] ||
       [ "$new_window" -lt "$old_window" ]; then
        echo "FAIL: $test_name recorded an impossible level credit window $new_window (previously $old_window)"
        exit 1
    fi
    # Use the window that the program actually recorded, rather than assuming that the transaction cannot cross a
    # window boundary while waiting for confirmation: only Ki applied earlier in the same window counts.
    old_ki=0
    if [ "$old_window" = "$new_window" ]; then
        old_ki=$(echo "$before" | jq -r '.ki_applied_this_window')
    fi
    requested_total=$(printf '%s\n' "$old_ki $amount + p" | dc)
    previous_total=$(level_credit_reference "$first" "$factor" "$bps" "$old_ki")
    added=$(level_credit_reference "$first" "$factor" "$bps" "$requested_total")
    # LevelUp burns only the least Ki that brings the window to the credits that the requested amount would earn.
    # If that least window total is below the requested total (and above what the window already had), only the
    # difference between it and what the window already had is burned, and it becomes the window's Ki total.
    next_total=$requested_total
    burned=$amount
    least=$(level_credit_least_ki_reference "$first" "$factor" "$bps" "$added")
    if [ "$least" != none ] && [ "$least" -gt "$old_ki" ] && [ "$least" -lt "$requested_total" ]; then
        next_total=$least
        burned=$((least - old_ki))
    fi
    # Transaction input and stored counters are whole Ki; token balances are in mint base units, which are
    # deciKi because the Ki mint has 1 decimal place.  deciki_amount is used only to check the burned amount.
    deciki_amount=$(printf '%s\n' "$burned 10 * p" | dc)
    # Make the window values available to callers
    LEVEL_UP_OLD_WINDOW=$old_window
    LEVEL_UP_NEW_WINDOW=$new_window
    LEVEL_UP_OLD_KI=$old_ki
    LEVEL_UP_NEXT_TOTAL=$next_total
    old_credits=$(echo "$before" | jq -r '.total_level_credits')
    expected=$(printf '%s\n' "$old_credits $added + $previous_total - p" | dc)
    # A contribution that earns no credits would make the credit comparison below trivially true, so require
    # that the reference says this contribution earns something
    if [ "$added" -le "$previous_total" ]; then
        echo "FAIL: $test_name contribution of $amount Ki earns no credits, so the credit check is not meaningful"
        echo "  first=$first factor=$factor bps=$bps old_ki=$old_ki"
        exit 1
    fi
    if [ "$(echo "$after" | jq -r '.total_level_credits')" != "$expected" ] ||
       [ "$(echo "$after" | jq -r '.ki_applied_this_window')" != "$next_total" ]; then
        echo "FAIL: $test_name incorrect window or lifetime credits"
        # Print the inputs and both sides of the comparison to aid diagnosis
        echo "  first=$first factor=$factor bps=$bps window_seconds=$LEVEL_CREDIT_WINDOW_SECONDS"
        echo "  old_window=$old_window new_window=$new_window old_ki=$old_ki amount=$amount burned=$burned"
        echo "  old_credits=$old_credits"
        echo "  previous_total=$previous_total added=$added"
        echo "  expected total_level_credits=$expected actual=$(echo "$after" | jq -r '.total_level_credits')"
        echo "  expected ki_applied_this_window=$next_total actual=$(echo "$after" | jq -r '.ki_applied_this_window')"
        echo "  before=$before"
        echo "  after=$after"
        exit 1
    fi
    cost=$((first * 10))
    for ((index=0; index<8; ++index)); do
        threshold=$((threshold + cost))
        if [ "$expected" -ge "$threshold" ]; then
            expected_level=$((index + 1))
        fi
        cost=$((cost + cost / 2))
    done
    if [ "$(echo "$after" | jq -r '.level')" != "$expected_level" ]; then
        echo "FAIL: $test_name incorrect level for lifetime credits $expected"
        exit 1
    fi
    # Entry 16 0 0 is staked, so LevelUp first harvests any Ki earned since the last harvest into the same Ki
    # account, at the ki_factor of the level before the contribution.  A harvest that mints anything moves the Ki
    # baseline up to the delegated stake at the time; the Ki minted is computed from that independently.
    ki_baseline_after=`entry_ki_baseline`
    if [ "$ki_baseline_after" != "$ki_baseline_before" ]; then
        harvest_factor=$(echo "$before" | jq -r '.metadata.level_metadata[.level].ki_factor')
        harvested=`expected_ki_mint $((ki_baseline_after - ki_baseline_before)) $ki_baseline_after $harvest_factor`
    fi
    new_balance=$(get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY)
    expected=$(printf '%s\n' "$balance $harvested + $deciki_amount - p" | dc)
    if [ "$new_balance" != "$expected" ]; then
        echo "FAIL: $test_name did not burn exactly $burned whole Ki ($deciki_amount base units) after harvesting"\
             "$harvested base units: balance went from $balance to $new_balance"
        exit 1
    fi
}

# Split available Ki across two contributions. Each must use the cumulative
# window curve rather than restarting the curve for the second transaction.
if should_run_test user_level_up_success; then
    # Harvesting requires stake rewards, which are only paid at epoch boundaries
    sleep_until_next_epoch
    assert user_level_up_success_setup                                                                               \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_harvest_tx.sh                                     \
         $RICH_USER1_PUBKEY 16 0 0 $DELEGATED_STAKE_PUBKEY                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    KI_BALANCE=$(get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY)
    WHOLE_KI_BALANCE=$(printf '%s\n' "$KI_BALANCE 10 / p" | dc)
    FIRST_CONTRIBUTION=$(printf '%s\n' "$WHOLE_KI_BALANCE 2 / p" | dc)
    SECOND_CONTRIBUTION=$(printf '%s\n' "$WHOLE_KI_BALANCE $FIRST_CONTRIBUTION - p" | dc)
    if [ "$FIRST_CONTRIBUTION" -lt 1 ]; then
        echo "FAIL: user_level_up_success requires harvested Ki"
        exit 1
    fi
    # Start at the beginning of a level credit window so that both contributions land in the same window
    sleep_until_next_level_credit_window
    apply_level_ki_and_check user_level_up_success "$FIRST_CONTRIBUTION"
    FIRST_TOTAL=$LEVEL_UP_NEXT_TOTAL
    apply_level_ki_and_check user_level_up_success_second "$SECOND_CONTRIBUTION"
    # Verify that the cumulative curve really was exercised: the second contribution must have been made in the same
    # window as the first, continuing from the window total that the first left (apply_level_ki_and_check has checked
    # the entry's recorded window total after each).  The window totals are those of the Ki actually burned, which
    # LevelUp may have reduced from the amounts requested.
    if [ "$FIRST_TOTAL" -lt 1 ] || [ "$LEVEL_UP_OLD_WINDOW" != "$LEVEL_UP_NEW_WINDOW" ] ||
       [ "$LEVEL_UP_OLD_KI" != "$FIRST_TOTAL" ]; then
        echo "FAIL: user_level_up_success contributions did not accumulate within one level credit window"
        exit 1
    fi
fi

