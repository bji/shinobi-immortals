
# Tests of WithdrawExcess (23): the admin withdraws the excess lamports of an account that the program controls.
#
# These tests make their own block group (77) so that they do not depend on what earlier tests left behind, with one
# deliberate exception: the test of the authority account first checks that after every mystery purchase, reveal and
# refund of the whole suite, the escrow total that the authority account records still accounts exactly for its
# balance.
#
# Withdrawal from a deactivated master stake account is tested by test/test_master_stake_recovery.sh, which runs on
# its own validator.

# This must be set so that user_stake_tx.sh will use the correct vote account
export SHINOBI_SYSTEMS_VOTE_PUBKEY=$VOTE_PUBKEY

WE_BYTE_0=`echo -n 0 | base64 | tr -d '\n'`
WE_BYTE_1=`echo -n 1 | base64 | tr -d '\n'`
WE_METADATA0=`(echo -n 0; dd if=/dev/zero bs=1 count=2843 status=none) | base64 | tr -d '\n'`
WE_METADATA1=`(echo -n 1; dd if=/dev/zero bs=1 count=2843 status=none) | base64 | tr -d '\n'`
WE_METADATA2=`(echo -n 2; dd if=/dev/zero bs=1 count=2843 status=none) | base64 | tr -d '\n'`
WE_SHA2560=`compute_metadata_sha256 $WE_METADATA0 0`
WE_SHA2561=`compute_metadata_sha256 $WE_METADATA1 1`
WE_SHA2562=`compute_metadata_sha256 $WE_METADATA2 2`

# Addresses of the accounts that these tests withdraw from, or try to
WE_BLOCK_0_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 77 u32 0 ]`
WE_MINT_0_0_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 5 pubkey $WE_BLOCK_0_PUBKEY u16 0 ]`
WE_ENTRY_0_0_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 15 pubkey $WE_MINT_0_0_PUBKEY ]`
WE_BLOCK_1_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 77 u32 1 ]`
WE_MINT_1_0_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 5 pubkey $WE_BLOCK_1_PUBKEY u16 0 ]`
WE_BID_MARKER_TOKEN_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 12 pubkey $WE_MINT_1_0_PUBKEY pubkey $RICH_USER2_PUBKEY ]`
WE_BID_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 9 pubkey $WE_BID_MARKER_TOKEN_PUBKEY ]`
# The whitelist of block 77 5, a block that is never created
WE_BLOCK_5_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 77 u32 5 ]`
WE_WHITELIST_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 13 pubkey $WE_BLOCK_5_PUBKEY ]`

# The account type codes of WithdrawExcessAccountType in program/admin/admin_withdraw_excess.c
WE_TYPE_MASTER_STAKE=0
WE_TYPE_STATE=1
WE_TYPE_AUTHORITY=2
WE_TYPE_BLOCK=3
WE_TYPE_ENTRY=4
WE_TYPE_WHITELIST=5


# Prints the balance of account $1 in lamports
function lamports_of ()
{
    solana -u l balance --lamports $1 | cut -d ' ' -f 1
}


# Prints a field of the JSON description of the master stake account, or "null" if it is not present
function master_stake_field ()
{
    solana -u l stake-account $MASTER_STAKE_PUBKEY --output json | jq -r ".$1"
}


# Prints the total that the authority account records as held in escrow: the u64 mystery_escrow_lamports at byte
# offset 8 of its data (program/inc/authority.h)
function authority_escrow ()
{
    get_account_data $AUTHORITY_PUBKEY 8 8 | base64 -d | od -An -tu8 -v | tr -d '[:space:]'
}


# Prints the rent exempt minimum of the authority account, whose data is 16 bytes long
function authority_rent_exempt_minimum ()
{
    solana -u l rent 16 --lamports | sed -e 's/[^0-9]//g'
}


# Prints, in lamports, the field $1 of what scripts/show.sh reports about the authority account.  show.sh reports
# amounts in SOL, so the amount is converted back to lamports.
function show_authority_lamports ()
{
    PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l authority | jq -r ".$1 * 1000000000 | round"
}


# Fails test $1 unless the balance of the authority account is exactly its rent exempt minimum plus the escrow total
# that it records
function check_authority_holds_exactly_escrow ()
{
    local BALANCE=`lamports_of $AUTHORITY_PUBKEY`
    local EXPECTED=$((`authority_rent_exempt_minimum` + `authority_escrow`))

    if [ "$BALANCE" != "$EXPECTED" ]; then
        echo "FAIL: $1: authority account has $BALANCE lamports, expected $EXPECTED (rent exempt minimum plus"       \
             "escrow of `authority_escrow`)"
        exit 1
    fi
}


# Submits a WithdrawExcess transaction made by scripts/admin_withdraw_excess_tx.sh, with the key file $1 as the admin
# and the remaining arguments naming the account to withdraw from; prints the result of submission
function withdraw_excess ()
{
    local KEY_FILE=$1
    shift

    SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY                                                                         \
        $SOURCE/scripts/admin_withdraw_excess_tx.sh `solxact pubkey $KEY_FILE` "$@"                                  \
        | solxact hash l                                                                                             \
        | solxact sign $KEY_FILE                                                                                     \
        | solxact submit l 2>&1
}


# Submits a WithdrawExcess transaction signed by the admin that names account $1 as being of account type code $2,
# whether or not it is; prints the result of submission.  Any further arguments are appended to the instruction data.
function withdraw_excess_raw ()
{
    local FROM_PUBKEY=$1
    shift

    echo "encoding c                                                                                                 \
          fee_payer $ADMIN_PUBKEY                                                                                    \
          program $SELF_PROGRAM_PUBKEY                                                                               \
          account $STATE_PUBKEY                                                                                      \
          account $ADMIN_PUBKEY ws                                                                                   \
          account $FROM_PUBKEY w                                                                                     \
          account $AUTHORITY_PUBKEY                                                                                  \
          account $CLOCK_SYSVAR_PUBKEY                                                                               \
          account $STAKE_PROGRAM_PUBKEY                                                                              \
          account $STAKE_HISTORY_SYSVAR_PUBKEY                                                                       \
          // Instruction code 23 = WithdrawExcess //                                                                 \
          u8 23                                                                                                      \
          $@"                                                                                                        \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1
}


# Tests withdrawal from an account that is required to hold only its rent exempt minimum.  $1 is the test name, $2 is
# the account's address, and the remaining arguments name the account to scripts/admin_withdraw_excess_tx.sh.
#
# - 1 SOL is transferred to the account.  It may already hold other excess lamports: the program state account does,
#   because test_super_initialize transfers lamports to its address before it is created.
# - The withdrawal leaves the account with exactly the rent exempt minimum for the size of its data, and the admin
#   receives everything else
# - And then there is nothing to withdraw
function test_withdraw_excess_of_program_account ()
{
    local TEST_NAME=$1
    local ACCOUNT_PUBKEY=$2
    shift
    shift

    local DATA_ORIGINAL=`get_account_data $ACCOUNT_PUBKEY`
    # The rent exempt minimum for an account whose data is as long as this account's
    local DATA_LEN=`echo -n "$DATA_ORIGINAL" | base64 -d | wc -c | tr -d '[:space:]'`
    local RENT_EXEMPT_MINIMUM=`solana -u l rent $DATA_LEN --lamports | sed -e 's/[^0-9]//g'`

    transfer $LEDGER/rich_user1.json $ACCOUNT_PUBKEY 1

    local ACCOUNT_BEFORE=`lamports_of $ACCOUNT_PUBKEY`
    local ADMIN_BEFORE=`lamports_of $ADMIN_PUBKEY`
    assert $TEST_NAME                                                                                                \
    `withdraw_excess $LEDGER/admin.json "$@"`
    local ACCOUNT_AFTER=`lamports_of $ACCOUNT_PUBKEY`
    local ADMIN_AFTER=`lamports_of $ADMIN_PUBKEY`

    # The account holds exactly its rent exempt minimum
    if [ "$ACCOUNT_AFTER" != "$RENT_EXEMPT_MINIMUM" ]; then
        echo "FAIL: $TEST_NAME: account has $ACCOUNT_AFTER lamports, expected $RENT_EXEMPT_MINIMUM"
        exit 1
    fi
    # At least the 1 SOL that was transferred in was withdrawn
    if [ $((ACCOUNT_BEFORE - ACCOUNT_AFTER)) -lt 1000000000 ]; then
        echo "FAIL: $TEST_NAME: only $((ACCOUNT_BEFORE - ACCOUNT_AFTER)) lamports withdrawn"
        exit 1
    fi
    # Its data is untouched
    if [ "`get_account_data $ACCOUNT_PUBKEY`" != "$DATA_ORIGINAL" ]; then
        echo "FAIL: $TEST_NAME: account data changed"
        exit 1
    fi
    # The admin received everything that left the account, and paid the 5000 lamport transaction fee
    if [ $((ADMIN_AFTER - ADMIN_BEFORE)) != $((ACCOUNT_BEFORE - ACCOUNT_AFTER - 5000)) ]; then
        echo "FAIL: $TEST_NAME: admin balance changed by $((ADMIN_AFTER - ADMIN_BEFORE)),"                           \
             "expected $((ACCOUNT_BEFORE - ACCOUNT_AFTER - 5000))"
        exit 1
    fi

    assert_fail ${TEST_NAME}_nothing_after                                                                           \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x413'                     \
    `withdraw_excess $LEDGER/admin.json "$@"`
}


