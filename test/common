function wait_for_block_time ()
{
    local end=$1

    while true; do
        local now=`current_block_time`
        if [ "0$now" -gt "0$end" ]; then
            break
        fi
        echo "Waiting for $(($end-$now)) more seconds"
        sleep 3
    done
}


function transfer ()
{
    local FROM=$1
    local TO=$2
    local SOL=$3

    echo "Transferring $SOL from $FROM to $TO"
    solana transfer -u l -k $FROM $TO $SOL --allow-unfunded-recipient --commitment finalized >/dev/null
}


function account_balance ()
{
    local ACCOUNT=$1

    solana balance -u l $ACCOUNT | cut -d ' ' -f 1    
}


# Assumes $FROM is the fee payer
function transfer_all_except ()
{
    local FROM=$1
    local TO=$2
    local EXCEPT_SOL=$3

    # Add 0.000005 to account for tx fee
    EXCEPT_SOL=`echo "20 k $EXCEPT_SOL 0.000005 + p" | dc`

    CURRENT_SOL=`account_balance $FROM`

    DIFF=`echo "20 k $CURRENT_SOL $EXCEPT_SOL - p" | dc`

    if [[ $DIFF != -* ]]; then
        echo "Transferring $DIFF from $FROM to $TO"
        solana transfer -u l -k $FROM $TO $DIFF --allow-unfunded-recipient --commitment finalized >/dev/null
    fi
}


# Returns 0 if $1 < $2, else returns 1
function less_than ()
{
    if [[ `echo "$1 $2 - p" | dc -` = -* ]]; then
        return 0
    else
        return 1
    fi
}


# How many times wait_for_transaction polls for a transaction's execution result, and how many seconds it waits
# between polls; together these give the longest time that a submitted transaction is waited for.
TRANSACTION_POLL_ATTEMPTS=50
TRANSACTION_POLL_INTERVAL_SECONDS=0.2


# Print a transaction only once its execution result is available. RPC errors,
# missing transactions, and missing metadata must never count as confirmation.
function wait_for_transaction ()
{
    local SIGNATURE=$1
    local JSON
    local i

    for i in `seq 1 $TRANSACTION_POLL_ATTEMPTS`; do
        if JSON=`curl -s --connect-timeout 2 --max-time 2 http://localhost:8899 -X POST                              \
                      -H "Content-Type: application/json"                                                            \
                      -d "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getTransaction\",\"params\":[\"$SIGNATURE\",\"json\"]}"`; then
            if echo "$JSON" | jq -e 'type == "object" and .error == null and
                                    (.result | type == "object") and
                                    (.result.meta | type == "object") and
                                    (.result.meta | has("err"))' >/dev/null; then
                echo "$JSON"
                return 0
            fi
        fi
        # Wait before polling again, but not after the final attempt
        if [ "$i" -lt "$TRANSACTION_POLL_ATTEMPTS" ]; then
            sleep $TRANSACTION_POLL_INTERVAL_SECONDS
        fi
    done

    return 1
}


function assert ()
{
    RESULT=$?
    
    local TEST_NAME=$1
    shift
    local TEST_OUTPUT=`normalize_success_output "$@"`

    if [ $RESULT -ne 0 ]; then
        echo "FAIL: $TEST_NAME failed (nonzero status) when success was expected:"
        echo "$TEST_OUTPUT"
        echo
        if [ -z "$NO_EXIT_ON_FAILURE" ]; then
            exit 1
        fi
    else
        # Transactions can successfully be submitted (passing simulation) but then fail when actually run on chain;
        # so fetch the transaction signature and wait until its results are known
        if [[ "$TEST_OUTPUT" = Transaction\ signature:\ * ]]; then
            SIGNATURE=`echo "$TEST_OUTPUT" | cut -d ' ' -f 3`
            if ! JSON=`wait_for_transaction "$SIGNATURE"`; then
                echo "FAIL: $TEST_NAME execution result unavailable after $TRANSACTION_POLL_ATTEMPTS attempts ($SIGNATURE)"
                exit 1
            fi
            if ! echo "$JSON" | jq -e '.result.meta.err == null' >/dev/null; then
                echo "FAIL: $TEST_NAME failed (result.meta.err) when success was expected:"
                echo "$JSON"
                if [ -z "$NO_EXIT_ON_FAILURE" ]; then
                   exit 1
                fi
            fi
            echo "+ $TEST_NAME"
            return
        fi
        echo "FAIL: $TEST_NAME failed (no tx signature) when success was expected:"
        echo "$TEST_OUTPUT"
        if [ -z "$NO_EXIT_ON_FAILURE" ]; then
           exit 1
        fi
    fi
}


function assert_fail ()
{
    RESULT=$?
    
    local TEST_NAME=$1
    shift
    local EXPECTED_OUTPUT=$1
    shift
    local TEST_OUTPUT=`normalize_error_output "$@"`

    if [ $RESULT -eq 0 ]; then
        # Transactions can successfully be submitted (passing simulation) but then fail when actually run on chain;
        # so fetch the transaction signature and wait until its results are known
        if [[ "$TEST_OUTPUT" = Transaction\ signature:\ * ]]; then
            SIGNATURE=`echo "$TEST_OUTPUT" | cut -d ' ' -f 3`
            if ! TEST_OUTPUT=`wait_for_transaction "$SIGNATURE"`; then
                echo "FAIL: $TEST_NAME execution result unavailable after $TRANSACTION_POLL_ATTEMPTS attempts ($SIGNATURE)"
                exit 1
            fi
            if echo "$TEST_OUTPUT" | jq -e '.result.meta.err == null' >/dev/null; then
                echo "FAIL: $TEST_NAME succeeded when failure was expected:"
                echo "$TEST_OUTPUT"
                if [ -z "$NO_EXIT_ON_FAILURE" ]; then
                    exit 1
                fi
            fi
        fi
    fi

    if [ "$EXPECTED_OUTPUT" != "$TEST_OUTPUT" ]; then
        echo "FAIL: $TEST_NAME incorrect output:"
        set +e
        diff <(echo "$EXPECTED_OUTPUT") <(echo "$TEST_OUTPUT")
        set -e
        echo
        if [ -z "$NO_EXIT_ON_FAILURE" ]; then
            exit 1
        fi
    else
        echo "- $TEST_NAME"
    fi
}


function lamports_from_sol ()
{
    local SOL=$1

    printf "%0.f" `echo "$SOL 1000 * 1000 * 1000 * p" | dc`
}


function sha256_of ()
{
    if [ -n "$1" ]; then
        echo -n "$@" | sha256sum | cut -d ' ' -f 1
    else
        sha256sum | cut -d ' ' -f 1
    fi
}


