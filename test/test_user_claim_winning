# Entry post-auction, is a winning bidder (success)
if should_run_test user_claim_winning_post_auction_winning_bidder; then
    # Test with block 12 2
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 12 u32 2 ]`
    MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 5 pubkey $BLOCK_PUBKEY u16 0 ]`
    ENTRY_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 15 pubkey $MINT_PUBKEY ]`
    BID_MARKER_TOKEN_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 12 pubkey $MINT_PUBKEY pubkey $RICH_USER1_PUBKEY ]`
    BID_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 9 pubkey $BID_MARKER_TOKEN_PUBKEY ]`
    TOKEN_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 6 pubkey $MINT_PUBKEY ]`
    ENTRY_METADATA_PUBKEY=`pda $METAPLEX_PROGRAM_PUBKEY [ string metadata pubkey $METAPLEX_PROGRAM_PUBKEY            \
                                                          pubkey $MINT_PUBKEY ]`
    # Record what the admin should receive: the winning bid account's lamports, and the rent of the entry's token
    # account, which must be closed (current_issues.txt issue 16)
    ADMIN_BEFORE=`solana -u l balance --lamports $ADMIN_PUBKEY | cut -d ' ' -f 1`
    BID_LAMPORTS=`solana -u l balance --lamports $BID_PUBKEY | cut -d ' ' -f 1`
    TOKEN_ACCOUNT_LAMPORTS=`solana -u l balance --lamports $TOKEN_PUBKEY | cut -d ' ' -f 1`
    if [ "0$TOKEN_ACCOUNT_LAMPORTS" -eq 0 ]; then
        echo "FAIL: user_claim_winning_post_auction_winning_bidder: entry token account does not exist before the claim"
        exit 1
    fi
    assert user_claim_winning_post_auction_winning_bidder                                                            \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_claim_winning_tx.sh                               \
         $ADMIN_PUBKEY $RICH_USER1_PUBKEY 12 2 0 true                                                                \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`

    # Check to make sure that if bid marker account is to be reclaimed, then it is
    if [ "`solana -u l balance $BID_MARKER_TOKEN_PUBKEY | cut -d ' ' -f 1`" != "0" ]; then
        echo "FAIL: user_claim_winning_post_auction_winning_bidder did not delete bid marker token account"
        exit 1
    fi

    # The entry's (now empty) token account must be closed, as Buy closes it
    if [ -n "`get_account_data $TOKEN_PUBKEY`" ] ||
       [ "`solana -u l balance --lamports $TOKEN_PUBKEY | cut -d ' ' -f 1`" != "0" ]; then
        echo "FAIL: user_claim_winning_post_auction_winning_bidder did not close the entry token account"
        exit 1
    fi

    # The admin must have received exactly the winning bid account's lamports plus the token account's rent
    ADMIN_AFTER=`solana -u l balance --lamports $ADMIN_PUBKEY | cut -d ' ' -f 1`
    if [ $((ADMIN_AFTER - ADMIN_BEFORE)) -ne $((BID_LAMPORTS + TOKEN_ACCOUNT_LAMPORTS)) ]; then
        echo "FAIL: user_claim_winning_post_auction_winning_bidder: admin received $((ADMIN_AFTER - ADMIN_BEFORE))," \
             "expected bid $BID_LAMPORTS plus token account rent $TOKEN_ACCOUNT_LAMPORTS"
        exit 1
    fi

    # Metaplex primary_sale_happened must be set, as Buy sets it.  In the Metaplex metadata account it follows the
    # key (1 byte), update authority (32), mint (32), name (4 + 32, as this program always writes it), symbol
    # (4 + 10), uri (4 + 200), seller_fee_basis_points (2), and the creators option: a 1 byte flag at offset 321 and,
    # when present, a u32 creator count at offset 322 followed by 34 bytes per creator.
    if [ "`get_account_data $ENTRY_METADATA_PUBKEY 321 1 | base64 -d | od -An -tu1 | tr -d ' '`" = "1" ]; then
        CREATOR_COUNT=`get_account_data $ENTRY_METADATA_PUBKEY 322 4 | base64 -d | od -An -tu4 | tr -d ' '`
        PRIMARY_SALE_OFFSET=$((326 + 34 * CREATOR_COUNT))
    else
        PRIMARY_SALE_OFFSET=322
    fi
    if [ "`get_account_data $ENTRY_METADATA_PUBKEY $PRIMARY_SALE_OFFSET 1 | base64 -d | od -An -tu1 | tr -d ' '`" != "1" ]; then
        echo "FAIL: user_claim_winning_post_auction_winning_bidder did not set Metaplex primary_sale_happened"
        exit 1
    fi
fi


