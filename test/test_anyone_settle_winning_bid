# Helpers
# ---------------------------------------------------------------------------------------------------------------------

# Sets the S_* variables to the correct accounts for a SettleWinningBid of entry $2 of block 12 $1, whose winning
# bidder is the pubkey $3 and which is funded by the pubkey $4.  A test then changes whichever of them it wants to be
# wrong before calling settle_submit.
function settle_accounts ()
{
    local BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 12 u32 $1 ]`

    S_MINT=`pda $SELF_PROGRAM_PUBKEY [ u8 5 pubkey $BLOCK_PUBKEY u16 $2 ]`
    S_ENTRY=`pda $SELF_PROGRAM_PUBKEY [ u8 15 pubkey $S_MINT ]`
    S_ENTRY_TOKEN=`pda $SELF_PROGRAM_PUBKEY [ u8 6 pubkey $S_MINT ]`
    S_METADATA=`pda $METAPLEX_PROGRAM_PUBKEY [ string metadata pubkey $METAPLEX_PROGRAM_PUBKEY pubkey $S_MINT ]`
    S_BID_MARKER_TOKEN=`pda $SELF_PROGRAM_PUBKEY [ u8 12 pubkey $S_MINT pubkey $3 ]`
    S_BID=`pda $SELF_PROGRAM_PUBKEY [ u8 9 pubkey $S_BID_MARKER_TOKEN ]`
    S_DESTINATION=`get_splata_account $S_MINT $3`
    # The bidder account, with the permissions that it has in the transaction
    S_BIDDER="$3 w"
    S_FUNDING=$4
    S_ADMIN=$ADMIN_PUBKEY
    # The optional accounts that reclaim the bid marker; none by default
    S_EXTRA_ACCOUNTS=
    # Instruction data that follows the instruction code; there is none
    S_DATA=
}


# Submits a SettleWinningBid transaction built from the S_* variables and signed by the key file $1, which must be
# that of the funding account.  Prints the result of submission.
function settle_submit ()
{
    echo "encoding c                                                                                                 \
          fee_payer $S_FUNDING                                                                                       \
          program $SELF_PROGRAM_PUBKEY                                                                               \
          account $S_FUNDING ws                                                                                      \
          account $S_ENTRY w                                                                                         \
          account $S_BID w                                                                                           \
          account $STATE_PUBKEY                                                                                      \
          account $S_ADMIN w                                                                                         \
          account $S_ENTRY_TOKEN w                                                                                   \
          account $S_MINT                                                                                            \
          account $AUTHORITY_PUBKEY                                                                                  \
          account $S_DESTINATION w                                                                                   \
          account $S_BIDDER                                                                                          \
          account $SYSTEM_PROGRAM_PUBKEY                                                                             \
          account $SPL_TOKEN_PROGRAM_PUBKEY                                                                          \
          account $SPLATA_PROGRAM_PUBKEY                                                                             \
          account $S_METADATA w                                                                                      \
          account $METAPLEX_PROGRAM_PUBKEY                                                                           \
          $S_EXTRA_ACCOUNTS                                                                                          \
          // Instruction code 18 = SettleWinningBid //                                                               \
          u8 18 $S_DATA"                                                                                             \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $1                                                                                            \
        | solxact submit l 2>&1
}


# Submits a SettleWinningBid transaction made by scripts/anyone_settle_winning_bid_tx.sh for entry $3 $4 $5 with the
# bidder pubkey $2, funded and signed by the key file $1.  $6 may be keep_bid_marker.  Prints the result of
# submission.
function settle_script ()
{
    SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/anyone_settle_winning_bid_tx.sh                         \
        `solxact pubkey $1` $ADMIN_PUBKEY $2 $3 $4 $5 $6                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $1                                                                                            \
        | solxact submit l 2>&1
}


# Prints the balance of account $1 in lamports
function settle_lamports_of ()
{
    solana -u l balance --lamports $1 | cut -d ' ' -f 1
}


# Prints the u64 at offset $2 of the data of account $1
function settle_account_u64 ()
{
    get_account_data $1 $2 8 | base64 -d | od -An -tu8 -v | tr -d '[:space:]'
}


# Offsets within an entry account of the purchase price and of the highest bid of its auction (program/inc/entry.h)
SETTLE_ENTRY_PURCHASE_PRICE_OFFSET=208
SETTLE_ENTRY_HIGHEST_BID_OFFSET=224


# Waits until anyone, and not only the winning bidder, may settle the winning bid of the entry account $1: until
# SETTLE_WINNING_BID_DELAY_SECONDS (which test/common builds the test program with) have passed since the end of the
# entry's auction.  The auction ends at the entry's reveal timestamp (the 8 byte value at offset 200 of the entry)
# plus its duration (the u32 at offset 156).
function settle_wait_until_anyone_may_settle ()
{
    local REVEAL_TIMESTAMP=`settle_account_u64 $1 200`
    local DURATION=`get_account_data $1 156 4 | base64 -d | od -An -tu4 -v | tr -d '[:space:]'`

    wait_for_block_time $((REVEAL_TIMESTAMP + DURATION + SETTLE_WINNING_BID_DELAY_SECONDS))
}


# Fails the test named $1 unless Metaplex primary_sale_happened is set in the metadata account $2, as Buy sets it.
# In the Metaplex metadata account it follows the key (1 byte), update authority (32), mint (32), name (4 + 32, as
# this program always writes it), symbol (4 + 10), uri (4 + 200), seller_fee_basis_points (2), and the creators
# option: a 1 byte flag at offset 321 and, when present, a u32 creator count at offset 322 followed by 34 bytes per
# creator.
function settle_check_primary_sale_happened ()
{
    local OFFSET=322
    if [ "`get_account_data $2 321 1 | base64 -d | od -An -tu1 | tr -d ' '`" = "1" ]; then
        local CREATOR_COUNT=`get_account_data $2 322 4 | base64 -d | od -An -tu4 | tr -d ' '`
        OFFSET=$((326 + 34 * CREATOR_COUNT))
    fi
    if [ "`get_account_data $2 $OFFSET 1 | base64 -d | od -An -tu1 | tr -d ' '`" != "1" ]; then
        echo "FAIL: $1 did not set Metaplex primary_sale_happened"
        exit 1
    fi
}


