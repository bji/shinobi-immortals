    apply_level_ki_and_check user_level_up_next_window "$WHOLE_KI_BALANCE"
    # Only this contribution counts in the new window: the contribution must have been made in a later window than the
    # previous one, so that apply_level_ki_and_check checked the entry's window total as starting over from 0
    if [ "$LEVEL_UP_OLD_WINDOW" = "$LEVEL_UP_NEW_WINDOW" ] || [ "$LEVEL_UP_OLD_KI" != 0 ]; then
        echo "FAIL: user_level_up_next_window did not restart the curve in the new level credit window"
        exit 1
    fi
fi

# A local validator cannot simulate months of maturation, so verify another redemption against the exact
# reference instead. The explicit level-9 rejection is tested by user_level_up_past_9 below, using a genesis fixture.
if should_run_test user_level_up_later_window; then
    sleep_until_next_epoch
    assert user_level_up_later_window_harvest                                                                       \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_harvest_tx.sh                                     \
         $RICH_USER1_PUBKEY 16 0 0 $DELEGATED_STAKE_PUBKEY                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    KI_BALANCE=$(get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY)
    WHOLE_KI_BALANCE=$(printf '%s\n' "$KI_BALANCE 10 / p" | dc)
    if [ "$WHOLE_KI_BALANCE" -gt 0 ]; then
        apply_level_ki_and_check user_level_up_later_window "$WHOLE_KI_BALANCE"
    fi
fi


# Levelling up a staked entry requires its stake account, since LevelUp harvests the Ki that the stake account has
# earned before applying the contribution.  Supplying some other account fails.
# 0x457 = 1111 = Error_InvalidAccount_First + 11
if should_run_test user_level_up_wrong_stake_account; then
    assert_fail user_level_up_wrong_stake_account                                                                    \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x457'                     \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_level_up_tx.sh                                    \
         $RICH_USER1_PUBKEY 16 0 0 1 none                                                                            \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
fi


# LevelUp on a staked entry first harvests the Ki earned since the last harvest, at the ki_factor of the entry's level
# before the contribution, so that rewards are always paid at the level at which they were earned.  Wait for the next
# epoch's rewards, without harvesting them, then level up: the Ki baseline must move, and the Ki account must gain
# exactly the harvested Ki less the Ki applied (both checked by apply_level_ki_and_check).
if should_run_test user_level_up_harvests_first; then
    TEST_NAME=user_level_up_harvests_first
    sleep_until_next_epoch
    BASELINE=`entry_ki_baseline`
    # Wait up to 60 seconds for this epoch's rewards to be paid to the stake account
    WAITED=0
    while true; do
        DELEGATED=`solana -u l stake-account $DELEGATED_STAKE_PUBKEY --output json | jq -r .delegatedStake`
        if [ $DELEGATED -gt $BASELINE ]; then
            break
        fi
        if [ $WAITED -ge 60 ]; then
            echo "FAIL: $TEST_NAME: no rewards were paid to the stake account above the Ki baseline $BASELINE"
            exit 1
        fi
        sleep 1
        WAITED=$((WAITED + 1))
    done
    # The pending rewards must be worth at least one whole Ki, or no harvest would happen and the test would prove
    # nothing.  All of this entry's levels have the same ki_factor, so level 0's is used.
    FACTOR=`PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 0 |                          \
            jq -r '.metadata.level_metadata[0].ki_factor'`
    PENDING=`expected_ki_mint $((DELEGATED - BASELINE)) $DELEGATED $FACTOR`
    if [ "$PENDING" -le 0 ]; then
        echo "FAIL: $TEST_NAME: precondition: the pending rewards ($((DELEGATED - BASELINE)) lamports) earn no Ki"
        exit 1
    fi
    # Start a new level credit window, so that the 1 Ki applied below earns credits however much was applied
    # earlier in the current window (a contribution that earns nothing is refused).  More rewards may be paid in the
    # meantime; that only adds to what is harvested.
    sleep_until_next_level_credit_window
    # Apply 1 Ki.  rich_user1 applied all of its whole Ki in user_level_up_later_window, so this relies on the
    # harvested Ki being minted before the contribution is burned.
    apply_level_ki_and_check $TEST_NAME 1
    if [ "`entry_ki_baseline`" = "$BASELINE" ]; then
        echo "FAIL: $TEST_NAME: LevelUp did not harvest the pending Ki"
        exit 1
    fi
fi


# LevelUp on a staked entry creates the Ki source account, as the Ki source owner's associated Ki token account, if it
# does not exist yet, so that a user who has never held Ki can level up using only the Ki that the entry has earned.
# Here the token owner, rich_user1, has the Ki go to (and be applied from) the associated Ki token account of a brand
# new keypair, which has never held Ki and which pays for the account's creation.
if should_run_test user_level_up_creates_ki_account; then
    TEST_NAME=user_level_up_creates_ki_account
    make_funded_keypair $LEDGER/level_up_ki_owner.json 1 finalized
    KI_OWNER_PUBKEY=`solxact pubkey $LEDGER/level_up_ki_owner.json`
    NEW_KI_ACCOUNT=`get_splata_account $KI_MINT_PUBKEY $KI_OWNER_PUBKEY`
    # Precondition: the Ki source account does not exist
    if [ -n "`get_account_data $NEW_KI_ACCOUNT`" ]; then
        echo "FAIL: $TEST_NAME: precondition: $NEW_KI_ACCOUNT already exists"
        exit 1
    fi
    # Wait for this epoch's rewards, so that the harvest mints at least 1 whole Ki, which is applied below
    sleep_until_next_epoch
    BASELINE=`entry_ki_baseline`
    WAITED=0
    while true; do
        DELEGATED=`solana -u l stake-account $DELEGATED_STAKE_PUBKEY --output json | jq -r .delegatedStake`
        if [ $DELEGATED -gt $BASELINE ]; then
            break
        fi
        if [ $WAITED -ge 60 ]; then
            echo "FAIL: $TEST_NAME: no rewards were paid to the stake account above the Ki baseline $BASELINE"
            exit 1
        fi
        sleep 1
        WAITED=$((WAITED + 1))
    done
    BEFORE=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 0)
    FACTOR=$(echo "$BEFORE" | jq -r '.metadata.level_metadata[.level].ki_factor')
    if [ "`expected_ki_mint $((DELEGATED - BASELINE)) $DELEGATED $FACTOR`" -lt 10 ]; then
        echo "FAIL: $TEST_NAME: precondition: the pending rewards ($((DELEGATED - BASELINE)) lamports) earn no whole Ki"
        exit 1
    fi
    # Start a new level credit window, so that the 1 Ki applied below earns credits however much was applied
    # earlier in the current window
    sleep_until_next_level_credit_window
    BEFORE=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 0)
    RICH_USER1_KI_BEFORE=`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 10 u32 16 u32 0 ]`
    MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 4 pubkey $BLOCK_PUBKEY u16 0 ]`
    ENTRY_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 11 pubkey $MINT_PUBKEY ]`
    ENTRY_METADATA_PUBKEY=`pda $METAPLEX_PROGRAM_PUBKEY [ string metadata                                            \
                                                          pubkey $METAPLEX_PROGRAM_PUBKEY                            \
                                                          pubkey $MINT_PUBKEY ]`
    TOKEN_PUBKEY=`get_splata_account $MINT_PUBKEY $RICH_USER1_PUBKEY`
    assert $TEST_NAME                                                                                                \
    `echo "encoding c                                                                                                \
           fee_payer $RICH_USER1_PUBKEY                                                                              \
           program $SELF_PROGRAM_PUBKEY                                                                              \
           account $BLOCK_PUBKEY                                                                                     \
           account $ENTRY_PUBKEY w                                                                                   \
           account $RICH_USER1_PUBKEY s                                                                              \
           account $TOKEN_PUBKEY                                                                                     \
           account $ENTRY_METADATA_PUBKEY w                                                                          \
           account $NEW_KI_ACCOUNT w                                                                                 \
           account $KI_OWNER_PUBKEY ws                                                                               \
           account $KI_MINT_PUBKEY w                                                                                 \
           account $AUTHORITY_PUBKEY                                                                                 \
           account $SPL_TOKEN_PROGRAM_PUBKEY                                                                         \
           account $METAPLEX_PROGRAM_PUBKEY                                                                          \
           account $DELEGATED_STAKE_PUBKEY                                                                           \
           account $SYSTEM_PROGRAM_PUBKEY                                                                            \
           account $SPLATA_PROGRAM_PUBKEY                                                                            \
           // Instruction code 17 = LevelUp //                                                                       \
           u8 17 u64 1"                                                                                              \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json $LEDGER/level_up_ki_owner.json                                        \
        | solxact submit l 2>&1`
    AFTER=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 0)
    # The Ki source account now exists, holding what was harvested (at the baseline move, as apply_level_ki_and_check
    # computes it) less the 1 Ki (10 base units) applied
    BASELINE_AFTER=`entry_ki_baseline`
    HARVESTED=`expected_ki_mint $((BASELINE_AFTER - BASELINE)) $BASELINE_AFTER $FACTOR`
    if [ -z "`get_account_data $NEW_KI_ACCOUNT`" ]; then
        echo "FAIL: $TEST_NAME: LevelUp did not create the Ki source account"
        exit 1
    fi
    if [ "$BASELINE_AFTER" = "$BASELINE" ] ||
       [ "`get_token_balance $KI_MINT_PUBKEY $KI_OWNER_PUBKEY`" != "$((HARVESTED - 10))" ]; then
        echo "FAIL: $TEST_NAME: Ki source account holds `get_token_balance $KI_MINT_PUBKEY $KI_OWNER_PUBKEY`,"     \
             "expected $HARVESTED harvested less 10 applied"
        exit 1
    fi
    # rich_user1's own Ki account was not touched
    if [ "`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`" != "$RICH_USER1_KI_BEFORE" ]; then
        echo "FAIL: $TEST_NAME: rich_user1's Ki balance changed"
        exit 1
    fi
    # And the contribution earned credits
    if [ "$(echo "$AFTER" | jq -r '.total_level_credits')" -le "$(echo "$BEFORE" | jq -r '.total_level_credits')" ]
    then
        echo "FAIL: $TEST_NAME: the contribution earned no level credits"
        exit 1
    fi
fi


# LevelUp burns only the least Ki that earns the credits awarded; Ki beyond that, which would earn nothing, is neither
# burned nor even required to be in the Ki account.  Entry 16 0 3's level credit curve is flat from the first Ki (see
# METADATA_FLAT), so a contribution of any amount earns exactly what 1 Ki does.  Request one more whole Ki than
# rich_user1 holds: before LevelUp limited the burn, this failed because the Ki account did not hold the amount
# requested; now it must succeed, and burn exactly 1 Ki.
if should_run_test user_level_up_excess_not_burned; then
    TEST_NAME=user_level_up_excess_not_burned
    # rich_user1 needs at least 1 whole Ki.  If it has none left from the tests above, harvest some from entry 16 0 0,
    # whose stake account earns rewards every epoch.
    WHOLE_KI_BALANCE=$(printf '%s\n' "`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY` 10 / p" | dc)
    if [ "$WHOLE_KI_BALANCE" -lt 1 ]; then
        sleep_until_next_epoch
        assert ${TEST_NAME}_harvest                                                                                  \
        `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_harvest_tx.sh                                 \
             $RICH_USER1_PUBKEY 16 0 0 $DELEGATED_STAKE_PUBKEY                                                       \
            | solxact hash l                                                                                         \
            | solxact sign $LEDGER/rich_user1.json                                                                   \
            | solxact submit l 2>&1`
        WHOLE_KI_BALANCE=$(printf '%s\n' "`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY` 10 / p" | dc)
        if [ "$WHOLE_KI_BALANCE" -lt 1 ]; then
            echo "FAIL: $TEST_NAME: precondition: rich_user1 has no whole Ki to apply"
            exit 1
        fi
    fi
    REQUESTED=$((WHOLE_KI_BALANCE + 1))
    BEFORE=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 3)
    FIRST=$(echo "$BEFORE" | jq -r '.metadata.level_1_credits')
    FACTOR=$(echo "$BEFORE" | jq -r '.metadata.level_metadata[0].ki_factor')
    BPS=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l block 16 0 |                              \
              jq -r '.configuration.expected_annual_reward_bps')
    # Precondition: this is the entry's first contribution, so the window's Ki total starts at 0 whatever the window
    if [ "$(echo "$BEFORE" | jq -r '.ki_applied_this_window')" != 0 ] ||
       [ "$(echo "$BEFORE" | jq -r '.total_level_credits')" != 0 ]; then
        echo "FAIL: $TEST_NAME: precondition: entry 16 0 3 has already received a contribution"
        exit 1
    fi
    # Precondition: the requested amount earns credits, and exactly what 1 Ki earns, so that only 1 Ki is needed
    CREDITS=$(level_credit_reference "$FIRST" "$FACTOR" "$BPS" "$REQUESTED")
    if [ "$CREDITS" -le 0 ] || [ "$CREDITS" != "$(level_credit_reference "$FIRST" "$FACTOR" "$BPS" 1)" ] ||
       [ "$(level_credit_least_ki_reference "$FIRST" "$FACTOR" "$BPS" "$CREDITS")" != 1 ]; then
        echo "FAIL: $TEST_NAME: precondition: entry 16 0 3's curve is not flat from 1 Ki"
        echo "  first=$FIRST factor=$FACTOR bps=$BPS requested=$REQUESTED credits=$CREDITS"
        exit 1
    fi
    BALANCE=`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`
    assert $TEST_NAME                                                                                                \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_level_up_tx.sh                                    \
         $RICH_USER1_PUBKEY 16 0 3 $REQUESTED none                                                                   \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    AFTER=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 3)
    # Exactly 1 Ki (10 base units) was burned; entry 16 0 3 is not staked, so nothing was harvested
    if [ "`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`" != "$((BALANCE - 10))" ]; then
        echo "FAIL: $TEST_NAME: did not burn exactly 1 Ki: balance went from $BALANCE to" \
             "`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`"
        exit 1
    fi
    # The window records only the Ki actually burned, and the full credits were awarded, without a level change
    if [ "$(echo "$AFTER" | jq -r '.ki_applied_this_window')" != 1 ] ||
       [ "$(echo "$AFTER" | jq -r '.total_level_credits')" != "$CREDITS" ] ||
       [ "$(echo "$AFTER" | jq -r '.level')" != 0 ]; then
        echo "FAIL: $TEST_NAME: incorrect window Ki, credits or level: $AFTER"
        exit 1
    fi
fi


# Entry already at level 9 (level index 8) can't be levelled up any further.  Reaching level 9 through transactions
# takes months by design, so this uses the genesis fixture entry created by setup in test/program/common (see
# make_max_level_entry_fixture), which is already at level index 8.  The maximum level check happens before the
# token, metadata, and Ki accounts are examined, so entry 16 0 0's real accounts are supplied for those.
if should_run_test user_level_up_past_9; then
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 10 u32 16 u32 0 ]`
    MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 4 pubkey $BLOCK_PUBKEY u16 0 ]`
    ENTRY_METADATA_PUBKEY=`pda $METAPLEX_PROGRAM_PUBKEY [ string metadata                                            \
                                                          pubkey $METAPLEX_PROGRAM_PUBKEY                            \
                                                          pubkey $MINT_PUBKEY ]`
    TOKEN_PUBKEY=`get_splata_account $MINT_PUBKEY $RICH_USER1_PUBKEY`
    KI_SOURCE_PUBKEY=`get_splata_account $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`
    # Record the fixture's contents and the Ki balance so that it can be checked that nothing was changed
    FIXTURE_BEFORE=`get_account_data $MAX_LEVEL_ENTRY_PUBKEY`
    BALANCE=`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`
    # 0x405 = 1029 = Error_AlreadyAtMaxLevel
    assert_fail user_level_up_past_9                                                                                 \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x405'                     \
    `echo "encoding c                                                                                                \
           fee_payer $RICH_USER1_PUBKEY                                                                              \
           program $SELF_PROGRAM_PUBKEY                                                                              \
           account $BLOCK_PUBKEY                                                                                     \
           account $MAX_LEVEL_ENTRY_PUBKEY w                                                                         \
           account $RICH_USER1_PUBKEY s                                                                              \
           account $TOKEN_PUBKEY                                                                                     \
           account $ENTRY_METADATA_PUBKEY w                                                                          \
           account $KI_SOURCE_PUBKEY w                                                                               \
           account $RICH_USER1_PUBKEY ws                                                                             \
           account $KI_MINT_PUBKEY w                                                                                 \
           account $AUTHORITY_PUBKEY                                                                                 \
           account $SPL_TOKEN_PROGRAM_PUBKEY                                                                         \
           account $METAPLEX_PROGRAM_PUBKEY                                                                          \
           account $DELEGATED_STAKE_PUBKEY                                                                           \
           account $SYSTEM_PROGRAM_PUBKEY                                                                            \
           account $SPLATA_PROGRAM_PUBKEY                                                                            \
           // Instruction code 17 = LevelUp //                                                                       \
           u8 17 u64 1"                                                                                              \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    # The rejected transaction must not have changed the fixture or burned any Ki
    if [ -z "$FIXTURE_BEFORE" ] || [ "$FIXTURE_BEFORE" != "`get_account_data $MAX_LEVEL_ENTRY_PUBKEY`" ] ||
       [ "$BALANCE" != "`get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`" ]; then
        echo "FAIL: user_level_up_past_9 fixture is missing, or was modified, or Ki was burned"
        exit 1
    fi
fi
