# The authority account, which holds the purchase prices of unrevealed mysteries in escrow.  These steps depend on
# each other, so they are one test.
if should_run_test admin_withdraw_excess_authority; then
    TEST_NAME=admin_withdraw_excess_authority

    # Every mystery purchase, reveal and refund that the earlier tests of the suite did went through the escrow
    # accounting.  Nothing but purchase prices was ever sent to the authority account, so its balance must now be
    # exactly its rent exempt minimum plus the escrow total that it records.
    check_authority_holds_exactly_escrow ${TEST_NAME}_after_suite

    # rich_user1 buys mysteries 77 0 0 and 77 0 1; each purchase price goes into escrow
    ESCROW_BEFORE=`authority_escrow`
    assert ${TEST_NAME}_buy_0                                                                                        \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_buy_tx.sh                                         \
         $ADMIN_PUBKEY $RICH_USER1_PUBKEY 77 0 0 \`lamports_from_sol 10000\`                                         \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    assert ${TEST_NAME}_buy_1                                                                                        \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_buy_tx.sh                                         \
         $ADMIN_PUBKEY $RICH_USER1_PUBKEY 77 0 1 \`lamports_from_sol 10000\`                                         \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    ESCROW_BOUGHT=`authority_escrow`
    # A mystery of this block costs at least its minimum price of 1 SOL, so the escrow grew by at least 2 SOL
    if [ $((ESCROW_BOUGHT - ESCROW_BEFORE)) -lt 2000000000 ]; then
        echo "FAIL: $TEST_NAME: escrow grew by only $((ESCROW_BOUGHT - ESCROW_BEFORE)) on the purchase of mysteries"
        exit 1
    fi
    check_authority_holds_exactly_escrow ${TEST_NAME}_after_buy

    # The authority account now holds a great deal of SOL, all of it escrow; none of it may be withdrawn
    assert_fail ${TEST_NAME}_only_escrow                                                                             \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x413'                     \
    `withdraw_excess $LEDGER/admin.json authority`

    # Someone transfers 1 SOL to the authority account.  Exactly that is withdrawn, and the escrow stays.
    transfer $LEDGER/rich_user1.json $AUTHORITY_PUBKEY 1
    # scripts/show.sh reports the escrow that the account records, and that the stray SOL is all that is withdrawable
    if [ "`show_authority_lamports mystery_escrow`" != "$ESCROW_BOUGHT" ] ||
       [ "`show_authority_lamports withdrawable_excess`" != "1000000000" ]; then
        echo "FAIL: $TEST_NAME: show.sh reports escrow `show_authority_lamports mystery_escrow` and excess"          \
             "`show_authority_lamports withdrawable_excess`, expected $ESCROW_BOUGHT and 1000000000"
        exit 1
    fi
    ADMIN_BEFORE=`lamports_of $ADMIN_PUBKEY`
    assert ${TEST_NAME}_stray                                                                                        \
    `withdraw_excess $LEDGER/admin.json authority`
    ADMIN_AFTER=`lamports_of $ADMIN_PUBKEY`
    if [ $((ADMIN_AFTER - ADMIN_BEFORE)) != $((1000000000 - 5000)) ]; then
        echo "FAIL: $TEST_NAME: admin balance changed by $((ADMIN_AFTER - ADMIN_BEFORE)),"                           \
             "expected $((1000000000 - 5000))"
        exit 1
    fi
    if [ "`authority_escrow`" != "$ESCROW_BOUGHT" ]; then
        echo "FAIL: $TEST_NAME: escrow total changed from $ESCROW_BOUGHT to `authority_escrow` on withdrawal"
        exit 1
    fi
    check_authority_holds_exactly_escrow ${TEST_NAME}_after_stray
    assert_fail ${TEST_NAME}_only_escrow_again                                                                       \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x413'                     \
    `withdraw_excess $LEDGER/admin.json authority`

    # Entry 77 0 1 is revealed: its purchase price leaves escrow for the admin
    assert ${TEST_NAME}_set_metadata_1                                                                               \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_set_metadata_bytes_tx.sh                         \
         $ADMIN_PUBKEY 77 0 1 0 $WE_BYTE_1                                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    AUTHORITY_BEFORE=`lamports_of $AUTHORITY_PUBKEY`
    assert ${TEST_NAME}_reveal_1                                                                                     \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_reveal_entries_tx.sh                             \
         $ADMIN_PUBKEY 77 0 1 1                                                                                      \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    ESCROW_REVEALED=`authority_escrow`
    # The escrow total fell by what left the authority account, which was a purchase price of at least 1 SOL
    PRICE_1=$((AUTHORITY_BEFORE - `lamports_of $AUTHORITY_PUBKEY`))
    if [ $PRICE_1 -lt 1000000000 ] || [ $((ESCROW_BOUGHT - ESCROW_REVEALED)) != $PRICE_1 ]; then
        echo "FAIL: $TEST_NAME: on reveal $PRICE_1 lamports left the authority account, and the escrow total fell"   \
             "by $((ESCROW_BOUGHT - ESCROW_REVEALED))"
        exit 1
    fi
    check_authority_holds_exactly_escrow ${TEST_NAME}_after_reveal

    # The price of 77 0 0, which was not revealed, is still in escrow and still cannot be withdrawn
    assert_fail ${TEST_NAME}_only_escrow_after_reveal                                                                \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x413'                     \
    `withdraw_excess $LEDGER/admin.json authority`

    # Wait to be sure that block 77 0 is past its 1 second reveal period, then rich_user1 gets a refund for 77 0 0.
    # The refund must succeed after everything that the admin withdrew, and takes its price out of escrow.
    sleep 2
    USER_BEFORE=`lamports_of $RICH_USER1_PUBKEY`
    AUTHORITY_BEFORE=`lamports_of $AUTHORITY_PUBKEY`
    assert ${TEST_NAME}_refund_0                                                                                     \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_refund_tx.sh                                      \
         $RICH_USER1_PUBKEY 77 0 0                                                                                   \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    PRICE_0=$((AUTHORITY_BEFORE - `lamports_of $AUTHORITY_PUBKEY`))
    # The user received the purchase price, and paid the 5000 lamport transaction fee
    USER_AFTER=`lamports_of $RICH_USER1_PUBKEY`
    if [ $PRICE_0 -lt 1000000000 ] || [ $((USER_AFTER - USER_BEFORE)) != $((PRICE_0 - 5000)) ]; then
        echo "FAIL: $TEST_NAME: refund of $PRICE_0 lamports did not reach the user"
        exit 1
    fi
    if [ $((ESCROW_REVEALED - `authority_escrow`)) != $PRICE_0 ]; then
        echo "FAIL: $TEST_NAME: on refund the escrow total fell by $((ESCROW_REVEALED - `authority_escrow`)),"       \
             "expected $PRICE_0"
        exit 1
    fi
    # Both mysteries of this test are out of escrow again, so the escrow total is what it was before them
    if [ "`authority_escrow`" != "$ESCROW_BEFORE" ]; then
        echo "FAIL: $TEST_NAME: escrow total is `authority_escrow`, expected $ESCROW_BEFORE"
        exit 1
    fi
    check_authority_holds_exactly_escrow ${TEST_NAME}_after_refund
fi


# A stake account that a user has staked to an entry belongs to that user, and is never an account that may be
# withdrawn from.  This uses entry 77 0 1, which the authority test left revealed and owned by rich_user1.
if should_run_test admin_withdraw_excess_user_stake_account; then
    make_stake_account $LEDGER/rich_user1.json $LEDGER/withdraw_excess_stake.json 10
    WE_STAKE_PUBKEY=`solxact pubkey $LEDGER/withdraw_excess_stake.json`
    assert admin_withdraw_excess_user_stake_account_stake                                                            \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_stake_tx.sh                                       \
         $RICH_USER1_PUBKEY 77 0 1 $WE_STAKE_PUBKEY                                                                  \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    # The stake account's authorities are now the program authority, as the master stake account's are; and it holds
    # lamports beyond what is staked.  It is still refused as every type.
    transfer $LEDGER/rich_user1.json $WE_STAKE_PUBKEY 1
    STAKE_BEFORE=`lamports_of $WE_STAKE_PUBKEY`
    for WE_TYPE in 0 1 2 3 4 5; do
        assert_fail admin_withdraw_excess_user_stake_account_as_type_$WE_TYPE                                        \
        'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x44e'                 \
        `withdraw_excess_raw $WE_STAKE_PUBKEY u8 $WE_TYPE`
    done
    if [ "`lamports_of $WE_STAKE_PUBKEY`" != "$STAKE_BEFORE" ]; then
        echo "FAIL: admin_withdraw_excess_user_stake_account: stake account balance changed"
        exit 1
    fi
fi


# The master stake account, while it is actively delegated: lamports that are in it but not staked are withdrawn, and
# nothing else is
if should_run_test admin_withdraw_excess_master_stake; then
    TEST_NAME=admin_withdraw_excess_master_stake

    # Put a known amount of lamports that are not staked into the master stake account.  There may be more there
    # already, left by earlier tests (SplitMasterStake with a pre-merge account leaves that account's rent exempt
    # reserve behind); whatever is there must all be withdrawn.
    transfer $LEDGER/rich_user1.json $MASTER_STAKE_PUBKEY 1

    # The balance and delegated stake of the master stake account are read together, from one description of it, both
    # before and after the withdrawal.  Stake rewards can be paid into the master stake account at any moment between
    # the two (the test validator's epochs are short); a reward adds the same amount to both its balance and its
    # delegated stake, so the growth of its delegated stake is the reward, which is what the checks below allow for.
    MASTER_BEFORE_JSON=`solana -u l stake-account $MASTER_STAKE_PUBKEY --output json`
    ADMIN_BEFORE=`lamports_of $ADMIN_PUBKEY`
    assert $TEST_NAME                                                                                                \
    `withdraw_excess $LEDGER/admin.json master_stake`
    MASTER_AFTER_JSON=`solana -u l stake-account $MASTER_STAKE_PUBKEY --output json`
    ADMIN_AFTER=`lamports_of $ADMIN_PUBKEY`
    MASTER_BEFORE=`echo "$MASTER_BEFORE_JSON" | jq -r .accountBalance`
    MASTER_AFTER=`echo "$MASTER_AFTER_JSON" | jq -r .accountBalance`
    DELEGATED_BEFORE=`echo "$MASTER_BEFORE_JSON" | jq -r .delegatedStake`
    DELEGATED_AFTER=`echo "$MASTER_AFTER_JSON" | jq -r .delegatedStake`
    # Any stake rewards paid into the master stake account between the two readings
    REWARDS=$((DELEGATED_AFTER - DELEGATED_BEFORE))

    # What must remain in the master stake account: its rent exempt reserve, plus the larger of its delegated stake
    # and its 2 SOL minimum
    MASTER_KEEP=$DELEGATED_AFTER
    if [ $MASTER_KEEP -lt 2000000000 ]; then
        MASTER_KEEP=2000000000
    fi
    MASTER_EXPECTED=$((`echo "$MASTER_AFTER_JSON" | jq -r .rentExemptReserve` + MASTER_KEEP))
    if [ "$MASTER_AFTER" != "$MASTER_EXPECTED" ]; then
        echo "FAIL: $TEST_NAME: master stake account has $MASTER_AFTER lamports, expected $MASTER_EXPECTED"
        exit 1
    fi
    # What was withdrawn is what left the master stake account, not counting any rewards that arrived meanwhile
    WITHDRAWN=$((MASTER_BEFORE + REWARDS - MASTER_AFTER))
    # At least the lamports that were just transferred in must have been withdrawn
    if [ $WITHDRAWN -lt 1000000000 ]; then
        echo "FAIL: $TEST_NAME: only $WITHDRAWN lamports withdrawn"
        exit 1
    fi
    # The admin received everything that was withdrawn, and paid the 5000 lamport transaction fee
    if [ $((ADMIN_AFTER - ADMIN_BEFORE)) != $((WITHDRAWN - 5000)) ]; then
        echo "FAIL: $TEST_NAME: admin balance changed by $((ADMIN_AFTER - ADMIN_BEFORE)), expected"                  \
             "$((WITHDRAWN - 5000)) (rewards paid meanwhile: $REWARDS)"
        exit 1
    fi
    # The master stake account is still actively delegated
    if [ "`master_stake_field deactivationEpoch`" != "null" ]; then
        echo "FAIL: $TEST_NAME: master stake account was deactivated"
        exit 1
    fi

    # With everything withdrawable now withdrawn, there is nothing left to withdraw
    assert_fail ${TEST_NAME}_nothing                                                                                 \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x413'                     \
    `withdraw_excess $LEDGER/admin.json master_stake`
fi
