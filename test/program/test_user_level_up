           [ "$BALANCE" != "$(get_token_balance $KI_MINT_PUBKEY $RICH_USER1_PUBKEY)" ]; then
            echo "FAIL: $TEST_NAME modified state or burned Ki"
            exit 1
        fi
    fi
done

# A contribution that earns no level credits is rejected, so that no Ki is burned for nothing.  Entry 16 0 2 has a
# level 1 credits value so small that no amount of Ki earns a tenth of a credit in the test program's short windows.
