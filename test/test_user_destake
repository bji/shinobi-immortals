# When Ki is to be harvested (no_ki_harvest is 0), the accounts that are used to harvest it are still required to be
# the correct accounts with the correct permissions.  (That they are not required when no_ki_harvest is 1 is tested
# in test_user_harvest, where the entries earn Ki.)
if should_run_test user_destake_bad_ki_accounts; then
    KI_DESTINATION_PUBKEY=`get_splata_account $KI_MINT_PUBKEY $RICH_USER1_PUBKEY`
    # Ki destination account not writable (Error_InvalidAccountPermissions_First + 6, 1206)
    assert_fail user_destake_bad_ki_accounts_destination_not_writable                                                \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x4b6'                     \
    `destake_14_0_0_raw "$KI_DESTINATION_PUBKEY" "$KI_MINT_PUBKEY w" $SPLATA_PROGRAM_PUBKEY u8 0 u8 0`
    # Not the Ki mint (Error_InvalidAccount_First + 9, 1109)
    assert_fail user_destake_bad_ki_accounts_wrong_mint                                                              \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x455'                     \
    `destake_14_0_0_raw "$KI_DESTINATION_PUBKEY w" "$BID_MARKER_MINT_PUBKEY w" $SPLATA_PROGRAM_PUBKEY u8 0 u8 0`
    # Ki mint not writable (Error_InvalidAccountPermissions_First + 9, 1209)
    assert_fail user_destake_bad_ki_accounts_mint_not_writable                                                       \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x4b9'                     \
    `destake_14_0_0_raw "$KI_DESTINATION_PUBKEY w" "$KI_MINT_PUBKEY" $SPLATA_PROGRAM_PUBKEY u8 0 u8 0`
    # Not the Associated Token Account program (Error_InvalidAccount_First + 16, 1116)
    assert_fail user_destake_bad_ki_accounts_wrong_ata_program                                                       \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x45c'                     \
    `destake_14_0_0_raw "$KI_DESTINATION_PUBKEY w" "$KI_MINT_PUBKEY w" $SPL_TOKEN_PROGRAM_PUBKEY u8 0 u8 0`
fi


# Success with no commission
if should_run_test user_destake_success_no_commission; then
    STAKED=`solana -u l stake-account $MASTER_STAKE_PUBKEY | grep "^Active Stake:" | cut -d ' ' -f 3`
    # Wait for master stake to settle, which would happen immediately after stake rewards paid.  This should then
    # given an interval for destaking that should not change master stake amount.
    while true; do
        NEW_STAKED=`solana -u l stake-account $MASTER_STAKE_PUBKEY | grep "^Active Stake:" | cut -d ' ' -f 3`
        if [ "$STAKED" != "$NEW_STAKED" ]; then
            STAKED=$NEW_STAKED
            break
        fi
        echo "Waiting for master stake to settle"
        sleep 1
    done
    # Save the master stake account account staked
    ADMIN_BALANCE=`lamports_from_sol \`account_balance $ADMIN_PUBKEY\``
    # The entry is staked, so its token account must be frozen (2) before the destake
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 14 u32 0 ]`
    MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 5 pubkey $BLOCK_PUBKEY u16 0 ]`
    if [ "`get_token_account_state $MINT_PUBKEY $RICH_USER1_PUBKEY`" != "2" ]; then
        echo "FAIL: user_destake_success_no_commission: token account of a staked entry is not frozen"
        exit 1
    fi
    assert user_destake_success_no_commission                                                                        \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_destake_tx.sh                                     \
         $RICH_USER1_PUBKEY 14 0 0 $DELEGATED_STAKE_PUBKEY                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    # Check that the master stake account has not changed its balance
    NEW_STAKED=`solana -u l stake-account $MASTER_STAKE_PUBKEY | grep "^Active Stake:" | cut -d ' ' -f 3`
    if [ "$STAKED" != "$NEW_STAKED" ]; then
        echo "FAIL: user_destake_success_no_commission: master stake account increased:"
        echo $STAKED
        echo $NEW_STAKED
        exit 1
    fi
    # Destake must have thawed the token account, which was frozen while the entry was staked: it must be back in the
    # Initialized state (1), still holding the token
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 14 u32 14 u32 0 ]`
    MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 5 pubkey $BLOCK_PUBKEY u16 0 ]`
    if [ "`get_token_account_state $MINT_PUBKEY $RICH_USER1_PUBKEY`" != "1" ] ||
       [ "`get_token_balance $MINT_PUBKEY $RICH_USER1_PUBKEY`" != "1" ]; then
        echo "FAIL: user_destake_success_no_commission: token account was not thawed"
        exit 1
    fi
fi


# Success with commission
if should_run_test user_destake_success_with_commission; then
    STAKED=`solana -u l stake-account $MASTER_STAKE_PUBKEY | grep "^Active Stake:" | cut -d ' ' -f 3`
    # Wait for master stake to settle, which would happen immediately after stake rewards paid.  This should then
    # given an interval for destaking that should not change master stake amount.
    while true; do
        NEW_STAKED=`solana -u l stake-account $MASTER_STAKE_PUBKEY | grep "^Active Stake:" | cut -d ' ' -f 3`
        if [ "$STAKED" != "$NEW_STAKED" ]; then
            STAKED=$NEW_STAKED
            break
        fi
        echo "Waiting for master stake to settle"
        sleep 1
    done
    # Save the master stake account account staked
    ADMIN_BALANCE=`lamports_from_sol \`account_balance $ADMIN_PUBKEY\``
    assert user_destake_success_with_commission                                                                      \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_destake_tx.sh                                     \
         $RICH_USER1_PUBKEY 14 2 0 $DELEGATED_STAKE3_PUBKEY                                                          \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    # Check that the master stake account has increased its balance
    NEW_STAKED=`solana -u l stake-account $MASTER_STAKE_PUBKEY | grep "^Active Stake:" | cut -d ' ' -f 3`
    if less_than $STAKED $NEW_STAKED; then
        echo -n
    else
        echo "FAIL: user_destake_success_with_commission: master stake account did not increase"
        exit 1
    fi
fi
