# Entry 12 2 1 was won by rich_user2, who settles it themselves: this is the winner claiming their win, which the
# winner may do as soon as the auction has ended.  There is no excess, so the admin receives the whole balance of the
# bid account.
if should_run_test anyone_settle_winning_bid_by_bidder; then
    TEST_NAME=anyone_settle_winning_bid_by_bidder
    settle_accounts 2 1 $RICH_USER2_PUBKEY $RICH_USER2_PUBKEY
    # The bid marker token account exists before settlement
    if [ "`settle_lamports_of $S_BID_MARKER_TOKEN`" = "0" ]; then
        echo "FAIL: $TEST_NAME: bid marker token account does not exist before settlement"
        exit 1
    fi
    WINNING_BID=`settle_account_u64 $S_ENTRY $SETTLE_ENTRY_HIGHEST_BID_OFFSET`
    TOKEN_ACCOUNT_LAMPORTS=`settle_lamports_of $S_ENTRY_TOKEN`
    ADMIN_BEFORE=`settle_lamports_of $ADMIN_PUBKEY`
    assert $TEST_NAME                                                                                                \
    `settle_script $LEDGER/rich_user2.json $RICH_USER2_PUBKEY 12 2 1`
    if [ "`get_token_balance $S_MINT $RICH_USER2_PUBKEY`" != "1" ]; then
        echo "FAIL: $TEST_NAME: the bidder did not receive the token"
        exit 1
    fi
    ADMIN_AFTER=`settle_lamports_of $ADMIN_PUBKEY`
    if [ $((ADMIN_AFTER - ADMIN_BEFORE)) -ne $((WINNING_BID + TOKEN_ACCOUNT_LAMPORTS)) ]; then
        echo "FAIL: $TEST_NAME: admin received $((ADMIN_AFTER - ADMIN_BEFORE)),"                                     \
             "expected bid $WINNING_BID plus token account rent $TOKEN_ACCOUNT_LAMPORTS"
        exit 1
    fi
    if [ "`settle_account_u64 $S_ENTRY $SETTLE_ENTRY_PURCHASE_PRICE_OFFSET`" != "$WINNING_BID" ]; then
        echo "FAIL: $TEST_NAME: purchase price is not the winning bid of $WINNING_BID"
        exit 1
    fi
    settle_check_primary_sale_happened $TEST_NAME $S_METADATA
    # Because the bidder settled, the bidder's bid marker tokens were burned and the bid marker token account closed
    if [ -n "`get_account_data $S_BID_MARKER_TOKEN`" ] || [ "`settle_lamports_of $S_BID_MARKER_TOKEN`" != "0" ]; then
        echo "FAIL: $TEST_NAME did not reclaim the bid marker token account"
        exit 1
    fi
fi


# Entry 12 2 0 was won by rich_user1.  rich_user2, who has nothing to do with the bid, settles it, once enough time
# has passed since the end of the auction.  Before that, 1 SOL is transferred to the bid account, so that it holds
# more than the winning bid.  The token must go to rich_user1, exactly the winning bid must go to the admin, exactly
# the excess must go back to rich_user1, and the entry's purchase price must be the winning bid.
if should_run_test anyone_settle_winning_bid_by_third_party; then
    TEST_NAME=anyone_settle_winning_bid_by_third_party
    settle_accounts 2 0 $RICH_USER1_PUBKEY $RICH_USER2_PUBKEY
    settle_wait_until_anyone_may_settle $S_ENTRY
    WINNING_BID=`settle_account_u64 $S_ENTRY $SETTLE_ENTRY_HIGHEST_BID_OFFSET`
    # A bid account is funded with exactly its bid
    if [ "`settle_lamports_of $S_BID`" != "$WINNING_BID" ]; then
        echo "FAIL: $TEST_NAME: bid account holds `settle_lamports_of $S_BID`, expected the bid of $WINNING_BID"
        exit 1
    fi
    # Someone transfers 1 SOL to the bid account.  This does not change the bid.
    transfer $LEDGER/rich_user2.json $S_BID 1
    if [ "`settle_account_u64 $S_ENTRY $SETTLE_ENTRY_HIGHEST_BID_OFFSET`" != "$WINNING_BID" ]; then
        echo "FAIL: $TEST_NAME: a transfer to the bid account changed the entry's highest bid"
        exit 1
    fi
    # The rent of the entry's token account, which is closed with its lamports going to the admin
    TOKEN_ACCOUNT_LAMPORTS=`settle_lamports_of $S_ENTRY_TOKEN`
    if [ "0$TOKEN_ACCOUNT_LAMPORTS" -eq 0 ]; then
        echo "FAIL: $TEST_NAME: entry token account does not exist before settlement"
        exit 1
    fi
    ADMIN_BEFORE=`settle_lamports_of $ADMIN_PUBKEY`
    BIDDER_BEFORE=`settle_lamports_of $RICH_USER1_PUBKEY`

    assert $TEST_NAME                                                                                                \
    `settle_script $LEDGER/rich_user2.json $RICH_USER1_PUBKEY 12 2 0`

    # The token is in rich_user1's associated token account, which rich_user2 paid to create
    if [ "`get_token_balance $S_MINT $RICH_USER1_PUBKEY`" != "1" ]; then
        echo "FAIL: $TEST_NAME: the bidder did not receive the token"
        exit 1
    fi
    # The admin received exactly the winning bid, plus the rent of the entry's token account
    ADMIN_AFTER=`settle_lamports_of $ADMIN_PUBKEY`
    if [ $((ADMIN_AFTER - ADMIN_BEFORE)) -ne $((WINNING_BID + TOKEN_ACCOUNT_LAMPORTS)) ]; then
        echo "FAIL: $TEST_NAME: admin received $((ADMIN_AFTER - ADMIN_BEFORE)),"                                     \
             "expected bid $WINNING_BID plus token account rent $TOKEN_ACCOUNT_LAMPORTS"
        exit 1
    fi
    # The bidder received exactly the excess, and paid for nothing
    BIDDER_AFTER=`settle_lamports_of $RICH_USER1_PUBKEY`
    if [ $((BIDDER_AFTER - BIDDER_BEFORE)) -ne 1000000000 ]; then
        echo "FAIL: $TEST_NAME: bidder's balance changed by $((BIDDER_AFTER - BIDDER_BEFORE)), expected 1000000000"
        exit 1
    fi
    # The purchase price recorded in the entry is the winning bid, not what the bid account held
    if [ "`settle_account_u64 $S_ENTRY $SETTLE_ENTRY_PURCHASE_PRICE_OFFSET`" != "$WINNING_BID" ]; then
        echo "FAIL: $TEST_NAME: purchase price is `settle_account_u64 $S_ENTRY $SETTLE_ENTRY_PURCHASE_PRICE_OFFSET`,"\
             "expected $WINNING_BID"
        exit 1
    fi
    # The bid account is gone
    if [ -n "`get_account_data $S_BID`" ] || [ "`settle_lamports_of $S_BID`" != "0" ]; then
        echo "FAIL: $TEST_NAME did not delete the bid account"
        exit 1
    fi
    # The entry's (now empty) token account must be closed, as Buy closes it
    if [ -n "`get_account_data $S_ENTRY_TOKEN`" ] || [ "`settle_lamports_of $S_ENTRY_TOKEN`" != "0" ]; then
        echo "FAIL: $TEST_NAME did not close the entry token account"
        exit 1
    fi
    # The bidder's bid marker token account is left alone; only the bidder can burn it
    if [ "`settle_lamports_of $S_BID_MARKER_TOKEN`" = "0" ]; then
        echo "FAIL: $TEST_NAME deleted the bid marker token account"
        exit 1
    fi
    settle_check_primary_sale_happened $TEST_NAME $S_METADATA
fi


