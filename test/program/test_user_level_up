    for no_credits_amount in 1 1000000000; do
        # 0x411 = 1041 = Error_NoLevelCreditsEarned
        assert_fail user_level_up_no_credits_$no_credits_amount                                                      \
        'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x40f'                 \
        `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_level_up_tx.sh                                \
             $RICH_USER2_PUBKEY 16 0 2 $no_credits_amount                                                            \
            | solxact hash l                                                                                         \
            | solxact sign $LEDGER/rich_user2.json                                                                   \
            | solxact submit l 2>&1`
    done
    AFTER=$(PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/show.sh -u l entry 16 0 2)
    # The level, window and credit fields of the entry must be exactly as they were
    PROGRESSION_FIELDS='[.level,.most_recent_ki_applied_window,.ki_applied_this_window,.total_level_credits]'
    BEFORE_PROGRESSION=$(echo "$BEFORE" | jq -c "$PROGRESSION_FIELDS")
    AFTER_PROGRESSION=$(echo "$AFTER" | jq -c "$PROGRESSION_FIELDS")
    if [ -z "$BEFORE" ] || [ "$BEFORE_PROGRESSION" != "$AFTER_PROGRESSION" ]; then
        echo "FAIL: user_level_up_no_credits modified the entry"
        exit 1
    fi
fi

