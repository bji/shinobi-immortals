
# Make sure that the admin has signed the tx
if should_run_test admin_delete_whitelist_no_auth; then
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 10 u32 7 u32 0 ]`
    WHITELIST_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 9 pubkey $BLOCK_PUBKEY ]`
    assert_fail admin_delete_whitelist_no_auth                                                                       \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x3ec'                     \
    `echo "encoding c                                                                                                \
           fee_payer $RICH_USER1_PUBKEY                                                                              \
           program $SELF_PROGRAM_PUBKEY                                                                              \
           account $STATE_PUBKEY                                                                                    \
           account $RICH_USER1_PUBKEY ws                                                                             \
           account $BLOCK_PUBKEY                                                                                     \
           account $WHITELIST_PUBKEY w                                                                               \
           // Instruction code 7 = DeleteWhitelist //                                                                \
           u8 7"                                                                                                     \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
fi


