# The level 0 ki_factor of these entries is 1,000,000,000 (00ca9a3b, little endian): one whole Ki per effective lamport,
# large enough that the 5% commission on a single epoch of rewards changes the Ki that a harvest mints (see
# anyone_take_commission_or_delegate_harvest_commission_harvest below)
METADATA=`(dd if=/dev/zero bs=1 count=76 status=none; echo 00ca9a3b | xxd -r -p; dd if=/dev/zero bs=1 count=2764 status=none) | base64 | tr -d '\n'`
# Metadata to set into entries, only needs to include up to the ki_factor
METADATA_HEAD=`(dd if=/dev/zero bs=1 count=76 status=none; echo 00ca9a3b | xxd -r -p) | base64 | tr -d '\n'`
SALT0=0
SALT1=1
SALT2=2
SHA2560=`compute_metadata_sha256 $METADATA $SALT0`
SHA2561=`compute_metadata_sha256 $METADATA $SALT1`
SHA2562=`compute_metadata_sha256 $METADATA $SALT2`


# This must be set so that user_stake_tx.sh will use the correct vote account
export SHINOBI_SYSTEMS_VOTE_PUBKEY=$VOTE_PUBKEY


# Create accounts and block
if [ -z "$TESTS" ]; then
    # Create stake accounts: delegated_stake, undelegated_stake
    make_stake_account $LEDGER/rich_user1.json $LEDGER/delegated5_stake.json 1000
    make_stake_account $LEDGER/rich_user2.json $LEDGER/delegated5_stake2.json 1000
    make_stake_account $LEDGER/rich_user1.json $LEDGER/undelegated5_stake.json 1000
    
    # Delegate the delegated stake accounts
    echo "Delegating $LEDGER/delegated5_stake.json"
    solana_stake -u l delegate-stake -k $LEDGER/rich_user1.json $LEDGER/delegated5_stake.json $VOTE_PUBKEY           \
           >/dev/null 2>/dev/null
    echo "Delegating $LEDGER/delegated5_stake2.json"
    solana_stake -u l delegate-stake -k $LEDGER/rich_user2.json $LEDGER/delegated5_stake2.json $VOTE_PUBKEY          \
           >/dev/null 2>/dev/null

    # Create a second vote account, standing in for a validator other than Shinobi Systems, so that stake accounts
    # delegated elsewhere can be staked to entries.  It never votes, which doesn't matter for these tests.
    echo "Creating other vote account"
    solana-keygen new -o $LEDGER/other_validator.json --no-bip39-passphrase --force --silent
    solana-keygen new -o $LEDGER/other_vote.json --no-bip39-passphrase --force --silent
    # The vote program requires the validator identity account to be funded when creating the vote account
    transfer $LEDGER/rich_user1.json `solxact pubkey $LEDGER/other_validator.json` 10
    solana -u l create-vote-account -k $LEDGER/rich_user1.json $LEDGER/other_vote.json $LEDGER/other_validator.json  \
           $RICH_USER1_PUBKEY --commitment finalized >/dev/null
    OTHER_VOTE_PUBKEY=`solxact pubkey $LEDGER/other_vote.json`

    # Create stake accounts delegated to the other vote account:
    # - elsewhere5_stake: will still be active elsewhere when staked to an entry
    # - elsewhere5_stake2: will be deactivated, and fully inactive, when staked to an entry
    # - elsewhere5_stake3: will be deactivated immediately before being staked to an entry, so still cooling down
    for i in "" 2 3; do
        make_stake_account $LEDGER/rich_user1.json $LEDGER/elsewhere5_stake$i.json 1000
        echo "Delegating $LEDGER/elsewhere5_stake$i.json to other vote account"
        # --force is needed because the other vote account never votes, so it has no root slot, and the solana
        # command line tool otherwise refuses to delegate to it
#        solana_stake -u l delegate-stake --force -k $LEDGER/rich_user1.json $LEDGER/elsewhere5_stake$i.json          \
#               $OTHER_VOTE_PUBKEY >/dev/null 2>/dev/null
       solana_stake -u l delegate-stake --force -k $LEDGER/rich_user1.json $LEDGER/elsewhere5_stake$i.json          \
              $OTHER_VOTE_PUBKEY
    done

    # Wait until end of epoch to ensure that these have delegated
    sleep_until_next_epoch

    # Deactivate elsewhere5_stake2 now; the sleep at the end of setup lets its cooldown complete
    echo "Deactivating $LEDGER/elsewhere5_stake2.json"
    solana_stake -u l deactivate-stake -k $LEDGER/rich_user1.json $LEDGER/elsewhere5_stake2.json >/dev/null 2>/dev/null

    # 17 0
    assert anyone_take_commission_or_delegate_setup_17_0_a                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_create_block_tx.sh                               \
         $ADMIN_PUBKEY 17 0 65535 3 0 $((24*60*60)) \`lamports_from_sol 1000\` 1                                      \
         \`lamports_from_sol 1\` false $((24*60*60)) \`lamports_from_sol 1000\` 0                                    \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert anyone_take_commission_or_delegate_setup_17_0_b                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_add_entries_to_block_tx.sh                       \
         $ADMIN_PUBKEY 17 0 "http://foo.bar.com" none 0 $SHA2560 $SHA2561                                            \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert anyone_take_commission_or_delegate_setup_17_0_c                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_add_entries_to_block_tx.sh                       \
         $ADMIN_PUBKEY 17 0 "http://foo.bar.com" none 2 $SHA2562                                                     \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    # set metadata
    assert anyone_take_commission_or_delegate_setup_17_0_d                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_set_metadata_bytes_tx.sh                         \
         $ADMIN_PUBKEY 17 0 0 0 $METADATA_HEAD                                                                       \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert anyone_take_commission_or_delegate_setup_17_0_e                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_set_metadata_bytes_tx.sh                         \
         $ADMIN_PUBKEY 17 0 1 0 $METADATA_HEAD                                                                       \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert anyone_take_commission_or_delegate_setup_17_0_f                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_set_metadata_bytes_tx.sh                         \
         $ADMIN_PUBKEY 17 0 2 0 $METADATA_HEAD                                                                       \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    # reveal entries
    assert anyone_take_commission_or_delegate_setup_17_0_g                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_reveal_entries_tx.sh                             \
         $ADMIN_PUBKEY 17 0 0 $SALT0 $SALT1 $SALT2                                                                   \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    # rich_user1 buy entry 0
    assert anyone_take_commission_or_delegate_setup_17_0_h                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_buy_tx.sh                                         \
         $ADMIN_PUBKEY $RICH_USER1_PUBKEY 17 0 0 \`lamports_from_sol 1001\`                                          \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    # rich_user1 stake entry 0
    assert anyone_take_commission_or_delegate_setup_17_0_i                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_stake_tx.sh                                       \
         $RICH_USER1_PUBKEY 17 0 0 $LEDGER/delegated5_stake.json                                                     \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    # rich_user2 buy entry 1
    assert anyone_take_commission_or_delegate_setup_17_0_j                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_buy_tx.sh                                         \
         $ADMIN_PUBKEY $RICH_USER2_PUBKEY 17 0 1 \`lamports_from_sol 1001\`                                          \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user2.json                                                                       \
        | solxact submit l 2>&1`
    # rich_user2 stake entry 1
    assert anyone_take_commission_or_delegate_setup_17_0_k                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_stake_tx.sh                                       \
         $RICH_USER2_PUBKEY 17 0 1 $LEDGER/delegated5_stake2.json                                                    \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user2.json                                                                       \
        | solxact submit l 2>&1`
    # rich_user2 buy entry 2
    assert anyone_take_commission_or_delegate_setup_17_0_l                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_buy_tx.sh                                         \
         $ADMIN_PUBKEY $RICH_USER1_PUBKEY 17 0 2 \`lamports_from_sol 1001\`                                          \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`

    # 17 0 0 is owned and staked by rich_user1
    # 17 0 1 is owned and staked by rich_user2
    # 17 0 2 is owned by rich_user1

    # 17 1
    assert anyone_take_commission_or_delegate_setup_17_1                                                             \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_create_block_tx.sh                               \
         $ADMIN_PUBKEY 17 1 65535 3 0 $((24*60*60)) \`lamports_from_sol 1000\` 1                                      \
         \`lamports_from_sol 1\` false $((24*60*60)) \`lamports_from_sol 1000\` 0                                    \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`

    # 17 1 is an incomplete block

    # 17 2: a complete, revealed block whose three entries are all owned by rich_user1 and not yet staked.  Used by the
    # tests of staking stake accounts that are delegated to a validator other than Shinobi Systems.
    assert anyone_take_commission_or_delegate_setup_17_2_a                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_create_block_tx.sh                               \
         $ADMIN_PUBKEY 17 2 65535 3 0 $((24*60*60)) \`lamports_from_sol 1000\` 1                                      \
         \`lamports_from_sol 1\` false $((24*60*60)) \`lamports_from_sol 1000\` 0                                    \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    # Add the entries two then one, since adding three in one transaction exceeds the compute limit
    assert anyone_take_commission_or_delegate_setup_17_2_b                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_add_entries_to_block_tx.sh                       \
         $ADMIN_PUBKEY 17 2 "http://foo.bar.com" none 0 $SHA2560 $SHA2561                                            \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    assert anyone_take_commission_or_delegate_setup_17_2_b2                                                          \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_add_entries_to_block_tx.sh                       \
         $ADMIN_PUBKEY 17 2 "http://foo.bar.com" none 2 $SHA2562                                                     \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    # Set the metadata of each entry
    for i in 0 1 2; do
        assert anyone_take_commission_or_delegate_setup_17_2_c_$i                                                    \
        `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_set_metadata_bytes_tx.sh                     \
             $ADMIN_PUBKEY 17 2 $i 0 $METADATA_HEAD                                                                  \
            | solxact hash l                                                                                         \
            | solxact sign $LEDGER/admin.json                                                                        \
            | solxact submit l 2>&1`
    done
    # Reveal the entries
    assert anyone_take_commission_or_delegate_setup_17_2_d                                                           \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/admin_reveal_entries_tx.sh                             \
         $ADMIN_PUBKEY 17 2 0 $SALT0 $SALT1 $SALT2                                                                   \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/admin.json                                                                            \
        | solxact submit l 2>&1`
    # rich_user1 buys each entry
    for i in 0 1 2; do
        assert anyone_take_commission_or_delegate_setup_17_2_e_$i                                                    \
        `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_buy_tx.sh                                     \
             $ADMIN_PUBKEY $RICH_USER1_PUBKEY 17 2 $i \`lamports_from_sol 1001\`                                     \
            | solxact hash l                                                                                         \
            | solxact sign $LEDGER/rich_user1.json                                                                   \
            | solxact submit l 2>&1`
    done

    # Sleep for an epoch to ensure that delegations all take effect
    sleep_until_next_epoch
fi


