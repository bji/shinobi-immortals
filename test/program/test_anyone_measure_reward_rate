# Tests of MeasureRewardRate, which measures the reward rate of a delegator to Shinobi Systems from the reference stake
# account, and records it in the program state for LevelUp to use.
#
# These run after the LevelUp tests (test_user_level_up), which therefore all run with the initial reward rate that
# Initialize was given (490 basis points; see test_super_initialize).  The last test here levels up again, with the
# measured rate.
#
# The test validator pays rewards at the start of every epoch (about every 10 seconds), during which MeasureRewardRate
# does nothing; so tests that wait for something to happen run the instruction repeatedly until it does.
#
# Program state layout (program/inc/program_state.h): reward_rate (u32) at 36, reward_rate_window (u64) at 40,
# snapshot_stake (u64) at 48, snapshot_epoch (u64) at 56, snapshot_epoch_start_timestamp (i64) at 64.


# This must be set so that anyone_measure_reward_rate_tx.sh uses the correct vote account
export SHINOBI_SYSTEMS_VOTE_PUBKEY=$VOTE_PUBKEY


# Prints the unsigned value of $2 bytes (4 or 8) at byte offset $1 of the program state
function measure_state_value ()
{
    local OFFSET=$1
    local SIZE=$2

    get_account_data $STATE_PUBKEY $OFFSET $SIZE | base64 -d | od -An -tu$SIZE -v | tr -d '[:space:]'
}


# Prints the delegated stake of the reference stake account
function reference_delegated_stake ()
{
    solana -u l stake-account $REFERENCE_STAKE_PUBKEY --output json | jq -r '.delegatedStake'
}


# Runs MeasureRewardRate, signed and paid for by rich_user1, printing the output of the submission.  $1, if given, is
# "require_measured".
function measure_reward_rate ()
{
    SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/anyone_measure_reward_rate_tx.sh $RICH_USER1_PUBKEY $1  \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1
}


# The reference measured reward rate: floor(floor(2^32 * 31536000 * (t - s) / s) / n) for a delegated stake that grew
# from s ($1) to t ($2) in n ($3) seconds (see test/program/calculation_vectors.sh, which checks the full range of
# inputs).  The stake here never more than doubles, nor falls.
function measured_rate_reference ()
{
    printf '%s\n' "4294967296 31536000 * $2 $1 - * $1 / $3 / p" | dc
}


# The reference updated rate, given the previous rate $1 and a measurement $2: the measurement limited to within
# floor(95%) and floor(105%) of the previous rate, then floor((3 * previous + limited) / 4), then kept between the
# bounds of 100 and 2000 basis points as fractions of 2^32 (see test/program/calculation_vectors.sh, which checks the
# full range of inputs).  In dc: registers p (previous), m (measurement), l and h (the limits), r (the rate), and b and
# t (the bounds).  "X Y <a" runs a if Y (the value pushed last) is less than X, and "X Y >a" runs it if Y is greater.
function updated_rate_reference ()
{
    printf '%s\n' "$1 sp $2 sm lp 95 * 100 / sl lp 105 * 100 / sh                                                    \
                    [ll sm]sa ll lm <a [lh sm]sa lh lm >a                                                           \
                    lp 3 * lm + 4 / sr                                                                              \
                    100 4294967296 * 10000 / sb 2000 4294967296 * 10000 / st                                        \
                    [lb sr]sa lb lr <a [lt sr]sa lt lr >a lr p" | dc
}


