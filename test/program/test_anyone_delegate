# Prints the value of a field of the JSON description of a stake account, or "null" if it is not present
function stake_field ()
{
    local STAKE_PUBKEY=$1
    local FIELD=$2

    solana -u l stake-account $STAKE_PUBKEY --output json | jq -r ".$FIELD"
}


# Prints a u64 value stored at a byte offset within an account's data
function account_u64 ()
{
    local ACCOUNT_PUBKEY=$1
    local OFFSET=$2

    get_account_data $ACCOUNT_PUBKEY $OFFSET 8 | base64 -d | od -An -tu8 -v | tr -d '[:space:]'
}


# Byte offset within Entry of owned.last_ki_harvest_stake_account_lamports
ENTRY_KI_BASELINE_OFFSET=296


# Prints the entry account address of entry $1 of block 17 2
function block_17_2_entry ()
{
    local BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 10 u32 17 u32 2 ]`
    local MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 4 pubkey $BLOCK_PUBKEY u16 $1 ]`
    pda $SELF_PROGRAM_PUBKEY [ u8 11 pubkey $MINT_PUBKEY ]
}


# Fails the test named $1 with the message $2
function fail_test ()
{
    echo "FAIL: $1: $2"
    exit 1
}


# Checks that the stake account $2 is delegated to vote account $3, has the program authority as both staker and
# withdrawer, and has deactivation state $4 ("deactivated" or "active"); fails test $1 if not
function check_stake ()
{
    local TEST_NAME=$1
    local STAKE_PUBKEY=$2
    local EXPECTED_VOTE_PUBKEY=$3
    local EXPECTED_STATE=$4

    local JSON=`solana -u l stake-account $STAKE_PUBKEY --output json`
    local VOTER=`echo "$JSON" | jq -r .delegatedVoteAccountAddress`
    local DEACTIVATION_EPOCH=`echo "$JSON" | jq -r .deactivationEpoch`

    if [ "$VOTER" != "$EXPECTED_VOTE_PUBKEY" ]; then
        fail_test $TEST_NAME "stake account delegated to $VOTER, expected $EXPECTED_VOTE_PUBKEY"
    fi
    if [ "`echo "$JSON" | jq -r .staker`" != "$AUTHORITY_PUBKEY" ] ||
       [ "`echo "$JSON" | jq -r .withdrawer`" != "$AUTHORITY_PUBKEY" ]; then
        fail_test $TEST_NAME "stake account authorities are not the program authority"
    fi
    if [ "$EXPECTED_STATE" = "deactivated" ] && [ "$DEACTIVATION_EPOCH" = "null" ]; then
        fail_test $TEST_NAME "stake account is not deactivated"
    fi
    if [ "$EXPECTED_STATE" = "active" ] && [ "$DEACTIVATION_EPOCH" != "null" ]; then
        fail_test $TEST_NAME "stake account is deactivated (epoch $DEACTIVATION_EPOCH)"
    fi
}


# Checks that entry $2's Ki baseline equals the delegated stake of stake account $3; fails test $1 if not
function check_baselines ()
{
    local TEST_NAME=$1
    local ENTRY_PUBKEY=$2
    local STAKE_PUBKEY=$3

    local DELEGATED=`stake_field $STAKE_PUBKEY delegatedStake`
    local KI_BASELINE=`account_u64 $ENTRY_PUBKEY $ENTRY_KI_BASELINE_OFFSET`

    if [ "$KI_BASELINE" != "$DELEGATED" ]; then
        fail_test $TEST_NAME "Ki baseline $KI_BASELINE, expected delegated stake $DELEGATED"
    fi
}


# Stake an entry with a stake account that is active and delegated elsewhere: Stake must succeed, take over the stake
# account's authorities, and deactivate it (leaving it delegated to the other validator until it is redelegated).
if should_run_test anyone_delegate_stake_elsewhere_active; then
    # Start at the beginning of an epoch, so that the stake account is still cooling down for the next test
    sleep_until_next_epoch
    assert anyone_delegate_stake_elsewhere_active                                                                    \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_stake_tx.sh                                       \
         $RICH_USER1_PUBKEY 17 2 0 $ELSEWHERE_STAKE_PUBKEY                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    check_stake anyone_delegate_stake_elsewhere_active $ELSEWHERE_STAKE_PUBKEY                                       \
                $OTHER_VOTE_PUBKEY deactivated
fi


# Redelegating a stake account that is still cooling down must fail; the stake program refuses with
# StakeError::TooSoonToRedelegate (3)
if should_run_test anyone_delegate_redelegate_too_soon; then
    assert_fail anyone_delegate_redelegate_too_soon                                                                  \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x3'                       \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/anyone_delegate_tx.sh                                  \
         $RICH_USER2_PUBKEY 17 2 0 $ELSEWHERE_STAKE_PUBKEY                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user2.json                                                                       \
        | solxact submit l 2>&1`
fi


# After the cooldown, anyone can redelegate the stake account to Shinobi Systems.  Before that, 100 SOL is deposited
# into the stake account while it is inactive; redelegation includes those lamports in the delegated stake, and the
# entry's Ki baseline must be reset to the new delegated stake so that the deposit is not counted as staking rewards.
if should_run_test anyone_delegate_redelegate; then
    transfer $LEDGER/rich_user1.json $ELSEWHERE_STAKE_PUBKEY 100
    sleep_until_next_epoch
    # rich_user2 runs the crank, to show that anyone can
    assert anyone_delegate_redelegate                                                                                \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/anyone_delegate_tx.sh                                  \
         $RICH_USER2_PUBKEY 17 2 0 $ELSEWHERE_STAKE_PUBKEY                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user2.json                                                                       \
        | solxact submit l 2>&1`
    check_stake anyone_delegate_redelegate $ELSEWHERE_STAKE_PUBKEY $VOTE_PUBKEY active
    # The delegated stake must include the deposit, which makes the baseline check below meaningful.  Without the
    # deposit it would be just under 1000 SOL (1000 SOL less the rent-exempt reserve); with it, just under 1100 SOL.
    DELEGATED=`stake_field $ELSEWHERE_STAKE_PUBKEY delegatedStake`
    if less_than $DELEGATED `lamports_from_sol 1050`; then
        fail_test anyone_delegate_redelegate "delegated stake $DELEGATED doesn't include deposit"
    fi
    check_baselines anyone_delegate_redelegate `block_17_2_entry 0` $ELSEWHERE_STAKE_PUBKEY
fi


# Delegating again while the redelegated stake account is still activating must fail with Error_AlreadyDelegated
# (1040) and change nothing
if should_run_test anyone_delegate_redelegated_activating; then
    assert_fail anyone_delegate_redelegated_activating                                                               \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x410'                     \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/anyone_delegate_tx.sh                                  \
         $RICH_USER2_PUBKEY 17 2 0 $ELSEWHERE_STAKE_PUBKEY                                                           \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user2.json                                                                       \
        | solxact submit l 2>&1`
    check_baselines anyone_delegate_redelegated_activating `block_17_2_entry 0` $ELSEWHERE_STAKE_PUBKEY
fi


# Stake an entry with a stake account that was delegated elsewhere and is now fully inactive: Stake must delegate it
# to Shinobi Systems immediately, with the Ki baseline set to the new delegated stake
if should_run_test anyone_delegate_stake_elsewhere_inactive; then
    assert anyone_delegate_stake_elsewhere_inactive                                                                  \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_stake_tx.sh                                       \
         $RICH_USER1_PUBKEY 17 2 1 $ELSEWHERE_STAKE2_PUBKEY                                                          \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
    check_stake anyone_delegate_stake_elsewhere_inactive $ELSEWHERE_STAKE2_PUBKEY                                    \
                $VOTE_PUBKEY active
    check_baselines anyone_delegate_stake_elsewhere_inactive `block_17_2_entry 1`                                    \
                    $ELSEWHERE_STAKE2_PUBKEY
fi


# Stake an entry with a stake account that was delegated elsewhere and is still cooling down: Stake tries to
# delegate it to Shinobi Systems, which the stake program refuses with StakeError::TooSoonToRedelegate (3)
if should_run_test anyone_delegate_stake_elsewhere_cooling; then
    echo "Deactivating $LEDGER/elsewhere5_stake3.json"
    solana_stake -u l deactivate-stake -k $LEDGER/rich_user1.json $LEDGER/elsewhere5_stake3.json --commitment finalized    \
           >/dev/null 2>/dev/null
    assert_fail anyone_delegate_stake_elsewhere_cooling                                                              \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x3'                       \
    `SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY $SOURCE/scripts/user_stake_tx.sh                                       \
         $RICH_USER1_PUBKEY 17 2 2 $ELSEWHERE_STAKE3_PUBKEY                                                          \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
fi
