# A winning bid cannot be refunded by supplying a different auction's entry.
# Entry 0's winning bid belongs to rich_user1; entry 1 is an eligible post-auction
# entry with a different winner.  Before the mint check, this combination drained
# entry 0's winning escrow because it was not entry 1's recorded winning bid.
if should_run_test user_claim_losing_mismatched_entry_winning_bid; then
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 10 u32 11 u32 2 ]`
    WINNING_MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 4 pubkey $BLOCK_PUBKEY u16 0 ]`
    OTHER_MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 4 pubkey $BLOCK_PUBKEY u16 1 ]`
    OTHER_ENTRY_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 11 pubkey $OTHER_MINT_PUBKEY ]`
    WINNING_MARKER_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 8 pubkey $WINNING_MINT_PUBKEY pubkey $RICH_USER1_PUBKEY ]`
    WINNING_BID_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 6 pubkey $WINNING_MARKER_PUBKEY ]`

    # Encode the mismatched accounts explicitly: the normal transaction builder
    # derives the bid and entry from the same mint.  Supply only three accounts
    # so optional marker reclamation cannot independently reject the attack.
    assert_fail user_claim_losing_mismatched_entry_winning_bid                                                       \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x44e'                     \
    `solxact encode                                                                                                  \
         encoding c                                                                                                  \
         fee_payer $RICH_USER1_PUBKEY                                                                                \
         program $SELF_PROGRAM_PUBKEY                                                                                \
         account $RICH_USER1_PUBKEY ws                                                                               \
         account $OTHER_ENTRY_PUBKEY                                                                                 \
         account $WINNING_BID_PUBKEY w                                                                               \
         u8 12                                                                                                       \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user1.json                                                                       \
        | solxact submit l 2>&1`
fi


