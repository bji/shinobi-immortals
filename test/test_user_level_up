
# Set up
# Level 1 credits is the first little endian 32 bit value.  0x00286bee is 4000000000 in little-endian.
# This is deliberately huge.  Credits per level credit window can never exceed 6*L/N tenths, where L is the lifetime
# level requirement (about 49.26 * 10 * level_1_credits) and N is the number of windows per year.  The test program's
# short window (LEVEL_CREDIT_WINDOW_SECONDS in test/common) makes N very large (525600 for 60 second windows), so with
# a small level_1_credits every contribution earns 0 credits no matter how large it is, and the credit checks would
# compare 0 with 0.  With this value, even a 1 Ki contribution earns many tenths of a credit.  As a consequence the
# entry never actually reaches level 1 in these tests.
# The ki_factor for levels appears as an unsigned little-endian 32 bit value at offset 76 + (level * 292).
# 0xf4240000 is 9460 in little-endian.
# Also set the names to the level.  This is used to ensure that metaplex metadata is being updated.  The first
# character of the name is at 80 + (level * 292).
# The last 4 bytes, at offset 2696, are expected_annual_reward_bps as a little-endian 32 bit value.  0xea010000 is
# 490 (4.90% per year) in little-endian.

METADATA=`(echo 0x00286bee | xxd -r | tr -d '\n';                                                                    \
           dd if=/dev/zero bs=1 count=64 status=none;                                                                \
           for i in \`seq 0 8\`; do                                                                                  \
               dd if=/dev/zero bs=1 count=8 status=none;                                                             \
               echo 0xf4240000 | xxd -r | tr -d '\n';                                                                \
               printf "%x" $i;                                                                                       \
               dd if=/dev/zero bs=1 count=279 status=none;                                                           \
           done;                                                                                                     \
           echo 0xea010000 | xxd -r | tr -d '\n') | base64 | tr -d '\n'`
METADATA_PIECE1=`echo "$METADATA" | base64 -d | dd bs=1 count=900 status=none           | base64 | tr -d '\n'`
METADATA_PIECE2=`echo "$METADATA" | base64 -d | dd bs=1 count=900 status=none skip=900  | base64 | tr -d '\n'`
METADATA_PIECE3=`echo "$METADATA" | base64 -d | dd bs=1           status=none skip=1800 | base64 | tr -d '\n'`
SALT0=0
SALT1=1
SALT2=2
SHA2560=`compute_metadata_sha256 $METADATA $SALT0`
SHA2561=`compute_metadata_sha256 $METADATA $SALT1`
SHA2562=`compute_metadata_sha256 $METADATA $SALT2`

