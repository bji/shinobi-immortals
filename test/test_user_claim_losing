# Bad bidding account
if should_run_test user_claim_losing_bad_bidding_account; then
    # Test with block 11 2
    BLOCK_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 10 u32 11 u32 2 ]`
    MINT_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 4 pubkey $BLOCK_PUBKEY u16 0 ]`
    ENTRY_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 11 pubkey $MINT_PUBKEY ]`
    BID_MARKER_TOKEN_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 8 pubkey $MINT_PUBKEY pubkey $RICH_USER1_PUBKEY ]`
    BID_PUBKEY=`pda $SELF_PROGRAM_PUBKEY [ u8 6 pubkey $BID_MARKER_TOKEN_PUBKEY ]`
    assert_fail user_claim_losing_bad_bidding_account                                                                \
    'Transaction simulation failed: Error processing Instruction 0: custom program error: 0x44c'                     \
    `echo "encoding c                                                                                                \
           fee_payer $RICH_USER2_PUBKEY                                                                              \
           program $SELF_PROGRAM_PUBKEY                                                                              \
           account $RICH_USER2_PUBKEY ws                                                                             \
           account $ENTRY_PUBKEY                                                                                     \
           account $BID_PUBKEY w                                                                                     \
           // Instruction code 12 = ClaimLosing //                                                                   \
           u8 12"                                                                                                    \
        | solxact encode                                                                                             \
        | solxact hash l                                                                                             \
        | solxact sign $LEDGER/rich_user2.json                                                                       \
        | solxact submit l 2>&1`
fi


