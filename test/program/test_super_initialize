# Issue a valid super_initialize tx and check to make sure that the correct state account was created
# This test cannot be skipped since the creation of a state account is a prerequisite for all other tests
# Send lamports to the state account, to ensure that if the account already exists, it is properly re-owned
transfer $LEDGER/admin.json $STATE_PUBKEY 0.1
INITIALIZE_WINDOW_BEFORE=$((`clock_unix_timestamp` / LEVEL_CREDIT_WINDOW_SECONDS))
assert super_initialize_success                                                                                      \
`SELF_PROGRAM_PUBKEY=$SELF_PROGRAM_PUBKEY SHINOBI_SYSTEMS_VOTE_PUBKEY=$VOTE_PUBKEY                                   \
     $SOURCE/scripts/super_initialize_tx.sh $SUPERUSER_PUBKEY $ADMIN_PUBKEY 490                                      \
    | solxact hash l                                                                                                 \
    | solxact sign $LEDGER/super.json                                                                                \
    | solxact submit l 2>&1`

INITIALIZE_WINDOW_AFTER=$((`clock_unix_timestamp` / LEVEL_CREDIT_WINDOW_SECONDS))

# Prints the little endian bytes of the $1 byte unsigned value $2, as hex
function le_hex ()
{
    local INDEX
    for INDEX in `seq 0 $(($1 - 1))`; do
        printf '%02x' $((($2 >> (8 * INDEX)) & 255))
    done
}

# The window in which Initialize set the reward rate (a u64 at byte offset 40), which must be the one in which it ran
INITIALIZE_WINDOW=`get_account_data $STATE_PUBKEY 40 8 | base64 -d | od -An -tu8 -v | tr -d '[:space:]'`
if [ "$INITIALIZE_WINDOW" -lt "$INITIALIZE_WINDOW_BEFORE" ] || [ "$INITIALIZE_WINDOW" -gt "$INITIALIZE_WINDOW_AFTER" ]
then
    echo "FAIL: super_initialize_success: reward rate window $INITIALIZE_WINDOW is not the one in which it ran"
    exit 1
fi

# Ensure that the state account was created and that its contents are as expected: the admin pubkey; the reward
# rate, which is the 490 basis points given, as a fraction of 2^32, rounded down (210453397); the window in which it was
# set; and no reference stake account snapshot (24 zero bytes).  The whole account is compared, which also checks that
# it is exactly 72 bytes.
EXPECTED_STATE_ACCOUNT_DATA=`(echo 01000000 | xxd -r -p; pubkey_binary $ADMIN_PUBKEY; le_hex 4 210453397 | xxd -r -p;  \
                              le_hex 8 $INITIALIZE_WINDOW | xxd -r -p; head -c 24 /dev/zero) | base64 | tr -d '\n'`
STATE_ACCOUNT_DATA=`get_account_data $STATE_PUBKEY`
if [ "$EXPECTED_STATE_ACCOUNT_DATA" != "$STATE_ACCOUNT_DATA" ]; then
    echo "FAIL: super_initialize_success: Incorrect account contents:"
    diff <(echo "$EXPECTED_STATE_ACCOUNT_DATA") <(echo "$STATE_ACCOUNT_DATA")
    exit 1
fi


# Ensure that the reference stake account was created: a stake account holding 2 SOL beyond its rent exempt reserve,
# all of it delegated to Shinobi Systems (the test validator's vote account), whose stake and withdraw authorities are
# both the program authority
REFERENCE_STAKE_JSON=`solana -u l stake-account $REFERENCE_STAKE_PUBKEY --output json`
for CHECK in "delegatedVoteAccountAddress $VOTE_PUBKEY" "delegatedStake 2000000000" "staker $AUTHORITY_PUBKEY"         \
             "withdrawer $AUTHORITY_PUBKEY"; do
    FIELD=`echo $CHECK | cut -d ' ' -f 1`
    EXPECTED=`echo $CHECK | cut -d ' ' -f 2`
    ACTUAL=`echo "$REFERENCE_STAKE_JSON" | jq -r ".$FIELD"`
    if [ "$ACTUAL" != "$EXPECTED" ]; then
        echo "FAIL: super_initialize_success: reference stake account $FIELD is $ACTUAL, expected $EXPECTED"
        exit 1
    fi
done


